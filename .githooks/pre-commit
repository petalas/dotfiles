#!/usr/bin/env bash
# Validate staged Bash and Zsh scripts before commit. CI runs the same checks.
set -euo pipefail

if ! command -v shellcheck >/dev/null 2>&1; then
    echo "[pre-commit] shellcheck not installed; skipping local lint."
    exit 0
fi

bash_files=()
zsh_files=()
while IFS= read -r file; do
    case "$file" in
        *.sh|install|lib/install-plan|tools/generate-brewfile|.githooks/pre-commit) bash_files+=("$file") ;;
        dot/zshrc|*.zsh|update-dotfiles) zsh_files+=("$file") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM)

if ((${#bash_files[@]})); then
    echo "[pre-commit] ShellCheck: ${bash_files[*]}"
    shellcheck --severity=warning --exclude=SC1090 "${bash_files[@]}"
    for file in "${bash_files[@]}"; do
        bash -n "$file"
    done
fi

if ((${#zsh_files[@]})) && command -v zsh >/dev/null 2>&1; then
    echo "[pre-commit] Zsh syntax: ${zsh_files[*]}"
    zsh -n "${zsh_files[@]}"
fi
