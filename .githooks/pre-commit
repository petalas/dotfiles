#!/usr/bin/env bash
# Validate staged Bash and Zsh scripts before commit through the same entry point CI uses.
set -euo pipefail

root_dir=$(git rev-parse --show-toplevel)
files=()
while IFS= read -r -d '' file; do files+=("$file"); done < <(git diff --cached --name-only --diff-filter=ACM -z)
((${#files[@]})) || exit 0
echo "[pre-commit] lint-shell over staged files"
exec "$root_dir/tools/lint-shell" "${files[@]}"
