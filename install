#!/usr/bin/env bash
# Run one supported installer from ./installers.
set -euo pipefail

cd "$(dirname "$0")"

if (($# > 1)); then
    echo "Usage: ./install [name|list]" >&2
    exit 2
fi

name="${1:-list}"
case "$name" in
    list|-h|--help)
        # shellcheck source=installers/source_installers.sh disable=SC1091
        source installers/source_installers.sh >/dev/null
        list_installers
        exit 0
        ;;
    install_*) short_name=${name#install_} ;;
    setup_*) short_name=${name#setup_} ;;
    *) short_name=$name ;;
esac

case "$short_name" in
    ''|*[!a-z0-9_]*)
        echo "Unknown installer: $name" >&2
        exit 2
        ;;
esac

function_name=""
if [[ -f "installers/install_$short_name.sh" ]]; then
    function_name="install_$short_name"
elif [[ -f "installers/setup_$short_name.sh" ]]; then
    function_name="setup_$short_name"
fi

if [[ -z "$function_name" ]]; then
    echo "Unknown installer: $name" >&2
    echo >&2
    # shellcheck source=installers/source_installers.sh disable=SC1091
    source installers/source_installers.sh >/dev/null
    list_installers >&2
    exit 1
fi

# shellcheck source=installers/source_installers.sh disable=SC1091
source installers/source_installers.sh >/dev/null
printf ':: running %s\n' "$function_name"
"$function_name"
