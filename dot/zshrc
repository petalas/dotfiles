if command -v brew >/dev/null 2>&1; then
  brew_lib=$(brew --prefix)/lib
  export LIBRARY_PATH="${LIBRARY_PATH:+$LIBRARY_PATH:}$brew_lib"
  unset brew_lib
  ruby_prefix=$(brew --prefix ruby 2>/dev/null) && path=("$ruby_prefix/bin" $path)
  unset ruby_prefix
