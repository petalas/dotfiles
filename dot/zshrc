    alias v="vim"
    alias vi="vim"
    alias vimdiff="vim -d"
fi

upd() {
  local updater="${DOTFILES_DIR:-$HOME/git/dotfiles}/update-dotfiles"
  [[ -x "$updater" ]] || { print -u2 "missing or not executable: $updater"; return 1; }
  "$updater"
}

# Kill listeners on one numeric TCP/UDP port.
kill-port() {
  (( $# == 1 )) && [[ $1 == <1-65535> ]] || {
    print -u2 "usage: kill-port PORT"
    return 2
  }
  local -a pids
  pids=(${(f)"$(sudo lsof -nP -t -i :$1 2>/dev/null | sort -u)"})
  (( ${#pids[@]} )) || { print "No process is listening on port $1."; return 0; }
  sudo kill -TERM "${pids[@]}"
}

# https://yazi-rs.github.io/docs/quick-start
# yazi wrapper that provides the ability to change the current working directory when exiting Yazi.
y() {
    local tmp cwd result
    tmp=$(mktemp -t "yazi-cwd.XXXXXX") || return 1
    {
        yazi "$@" --cwd-file="$tmp"
        result=$?
        if cwd=$(command cat -- "$tmp") && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
            builtin cd -- "$cwd"
        fi
        return $result
    } always {
        rm -f -- "$tmp"
    }
}

