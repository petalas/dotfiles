# Use the UTF-8 locale provisioned by the Linux setup scripts and available by
# default on macOS. Fall back cleanly while bootstrapping an existing machine;
# exporting a locale that does not exist makes tools such as manpath print
# during shell startup and trips Powerlevel10k's instant-prompt warning.
if LC_ALL=en_US.UTF-8 locale charmap 2>/dev/null | grep -qx UTF-8; then
    export LANG=en_US.UTF-8
elif LC_ALL=C.UTF-8 locale charmap 2>/dev/null | grep -qx UTF-8; then
    export LANG=C.UTF-8
else
    export LANG=C
fi

# LANG provides defaults for every category; clearing overrides prevents SSH
# and Mosh from forwarding a stale, unavailable locale.
unset LC_ALL LC_CTYPE

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block, everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Keep PATH-like arrays free of duplicates. Any subsequent `export PATH=...`
# that prepends/appends an already-present entry is silently deduped.
typeset -U path PATH fpath FPATH
path=(
    "$HOME/bin"
    "$HOME/.local/bin"
    "$HOME/.cargo/bin"
    $path
)
if [[ $OSTYPE == darwin* ]]; then
    [[ -d /opt/homebrew/sbin ]] && path=(/opt/homebrew/sbin $path)
    [[ -d "$HOME/Library/pnpm" ]] && path=("$HOME/Library/pnpm" $path)
fi

# nvm is a shell function rather than a standalone executable. The installer
# deliberately leaves shell profiles untouched, so activate it here.
export NVM_DIR="$HOME/.nvm"
[[ ! -s "$NVM_DIR/nvm.sh" ]] || source "$NVM_DIR/nvm.sh"

if command -v nvim >/dev/null 2>&1; then
    export EDITOR="$(command -v nvim)"
    export SUDO_EDITOR="$EDITOR"
elif command -v vim >/dev/null 2>&1; then
    export EDITOR="$(command -v vim)"
    export SUDO_EDITOR="$EDITOR"
else
    export EDITOR=vi
    export SUDO_EDITOR=vi
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

