[[ ! -r "$_DOTFILES_ZSH_DIR/seashells.zsh" ]] || source "$_DOTFILES_ZSH_DIR/seashells.zsh"

# Set up Oh My Zsh only after its installer has completed successfully.
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
else
    print -u2 "Oh My Zsh is not installed; run dotfiles/configure-zsh.sh."
