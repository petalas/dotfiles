if [[ -x "$HOME/miniconda3/bin/conda" ]]; then
  __conda_setup=$("$HOME/miniconda3/bin/conda" shell.zsh hook 2>/dev/null)
  if (( $? == 0 )); then
    eval "$__conda_setup"
  elif [[ -r "$HOME/miniconda3/etc/profile.d/conda.sh" ]]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
  fi
  unset __conda_setup
fi

if [[ -d "$HOME/Library/pnpm" ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
elif [[ -d "$HOME/.local/share/pnpm" ]]; then
  export PNPM_HOME="$HOME/.local/share/pnpm"
  path=("$PNPM_HOME" $path)
fi

if [[ -d "$HOME/.bun" ]]; then
  export BUN_INSTALL="$HOME/.bun"
  path=("$BUN_INSTALL/bin" $path)
  # bun completions
  [[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"
fi
[[ -d "$HOME/.maestro/bin" ]] && path+=("$HOME/.maestro/bin")
[[ -d "$HOME/.lmstudio/bin" ]] && path+=("$HOME/.lmstudio/bin")

if [[ $OSTYPE == darwin* && -d /opt/homebrew/share/android-commandlinetools ]]; then
  export ANDROID_HOME=/opt/homebrew/share/android-commandlinetools
  path+=("$ANDROID_HOME/emulator" "$ANDROID_HOME/platform-tools")
fi

export SDKMAN_DIR="$HOME/.sdkman"
if [[ -r "$SDKMAN_DIR/bin/sdkman-init.sh" ]]; then
  # SDKMAN does not promote candidate paths that already exist later in an
  # inherited PATH. Remove stale positions so its loader can prepend them.
  path=(${path:#$SDKMAN_DIR/candidates/*/current/bin})
  source "$SDKMAN_DIR/bin/sdkman-init.sh"
fi

# Machine-specific secrets and overrides live outside this repository.
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
[[ -r "$HOME/.vite-plus/env" ]] && source "$HOME/.vite-plus/env"
