#!/usr/bin/env bash
# Resolve and execute installation plans from the canonical catalog.
set -euo pipefail
# Apple ships Bash 3.2, where expanding a declared-but-empty array under
# nounset raises an error. The engine validates every external field itself;
# retain errexit/pipefail while disabling only that incompatible shell option.
if ((BASH_VERSINFO[0] < 4)); then set +u; fi

root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
catalog_dir=${DOTFILES_CATALOG_DIR:-$root_dir/catalog}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
default_record=${DOTFILES_PLAN_RECORD:-$state_home/dotfiles/installation-plan}
collect_versions=0
version_inventory_ready=0
version_inventory_dir=

fail() {
    echo "install-plan: $*" >&2
    exit 1
}

warn() {
    echo "Warning: $*"
}

valid_id() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9.-]*$ ]]
}

valid_ai_skill_source() {
    case "$1" in
        ''|-*|*[[:space:]]*) return 1 ;;
        http://*|https://*|git@*:*|[A-Za-z0-9_.-]*/*) return 0 ;;
        *) return 1 ;;
    esac
}

valid_ai_skill_name() {
    valid_id "$1"
}

find_value_index() {
    local needle=$1
    shift
    local index=0 value
    for value in "$@"; do
        if [[ "$value" == "$needle" ]]; then
            printf '%s\n' "$index"
            return 0
        fi
        index=$((index + 1))
    done
    return 1
}

load_ai_skill_applications() {
    local path line_number=0 source skill extra id prerequisite
    ai_skill_sources=(); ai_skill_names=()
    path="$catalog_dir/ai-skills.tsv"
    [[ -r "$path" ]] || return 0
    find_value_index ai-skills "${group_ids[@]}" >/dev/null 2>&1 ||
        fail "AI skills catalog requires group ai-skills"
    if find_value_index languages.node "${app_ids[@]}" >/dev/null 2>&1; then
        prerequisite=languages.node
    else
        prerequisite=
    fi
    while IFS=$'\t' read -r source skill extra; do
        line_number=$((line_number + 1))
        [[ -n "$source$skill${extra:-}" ]] || continue
        case "$source" in \#*) continue ;; esac
        [[ -n "$source" && -n "$skill" && -z "${extra:-}" ]] ||
            fail "malformed AI skills catalog row $line_number"
        valid_ai_skill_source "$source" || fail "invalid AI skill source on row $line_number: $source"
        valid_ai_skill_name "$skill" || fail "invalid AI skill name on row $line_number: $skill"
        id="ai-skills.$skill"
        find_value_index "$id" "${app_ids[@]}" >/dev/null 2>&1 && fail "duplicate application id: $id"
        find_value_index "$skill" "${ai_skill_names[@]}" >/dev/null 2>&1 && fail "duplicate AI skill: $skill"
        app_ids+=("$id"); app_groups+=(ai-skills); app_labels+=("AI skill: $skill")
        app_states+=(on); app_prerequisites+=("$prerequisite")
        ai_skill_sources+=("$source"); ai_skill_names+=("$skill")
    done <"$path"
}

load_catalog() {
    local os=$1 order id label default adapter argument group state prerequisites
    local action_provider action_role action_kind action_value action_option action_index removal_index
    step_orders=(); step_ids=(); step_labels=(); step_defaults=(); step_adapters=(); step_arguments=()
    group_orders=(); group_ids=(); group_labels=(); group_defaults=()
    app_ids=(); app_groups=(); app_labels=(); app_states=(); app_prerequisites=()
    ai_skill_sources=(); ai_skill_names=()
    action_apps=(); action_providers=(); action_roles=(); action_kinds=(); action_values=(); action_options=()
    removal_oses=(); removal_apps=(); removal_methods=(); removal_targets=(); removal_options=()

    [[ -r "$catalog_dir/steps.tsv" ]] || fail "missing catalog file: $catalog_dir/steps.tsv"
    while IFS=$'\t' read -r order id label default adapter argument; do
        [[ -n "$order$id$label$default$adapter${argument:-}" ]] || continue
        [[ "$order" =~ ^[0-9]+$ ]] || fail "invalid step order: $order"
        valid_id "$id" || fail "invalid step id: $id"
        find_value_index "$id" "${step_ids[@]}" >/dev/null 2>&1 && fail "duplicate step id: $id"
        find_value_index "$order" "${step_orders[@]}" >/dev/null 2>&1 && fail "duplicate step order: $order"
        [[ "$default" == on || "$default" == off ]] || fail "invalid step default for $id: $default"
        [[ "$adapter" == dependencies || "$adapter" == command || "$adapter" == installer ]] ||
            fail "invalid step adapter for $id: $adapter"
        step_orders+=("$order"); step_ids+=("$id"); step_labels+=("$label")
        step_defaults+=("$default"); step_adapters+=("$adapter"); step_arguments+=("${argument:-}")
    done <"$catalog_dir/steps.tsv"

    [[ -r "$catalog_dir/groups.tsv" ]] || fail "missing catalog file: $catalog_dir/groups.tsv"
    while IFS=$'\t' read -r order id label default; do
        [[ -n "$order$id$label$default" ]] || continue
        [[ "$order" =~ ^[0-9]+$ ]] || fail "invalid group order: $order"
        valid_id "$id" || fail "invalid group id: $id"
        find_value_index "$id" "${group_ids[@]}" >/dev/null 2>&1 && fail "duplicate group id: $id"
        find_value_index "$order" "${group_orders[@]}" >/dev/null 2>&1 && fail "duplicate group order: $order"
        [[ "$default" == on || "$default" == off ]] || fail "invalid group default for $id: $default"
        group_orders+=("$order"); group_ids+=("$id"); group_labels+=("$label"); group_defaults+=("$default")
    done <"$catalog_dir/groups.tsv"

    [[ -r "$catalog_dir/applications.tsv" ]] || fail "missing catalog file: $catalog_dir/applications.tsv"
    while IFS=$'\t' read -r id group label state prerequisites; do
        [[ -n "$id$group$label$state${prerequisites:-}" ]] || continue
        valid_id "$id" || fail "invalid application id: $id"
        find_value_index "$id" "${app_ids[@]}" >/dev/null 2>&1 && fail "duplicate application id: $id"
        find_value_index "$group" "${group_ids[@]}" >/dev/null 2>&1 || fail "unknown group $group for application $id"
        [[ "$state" == on || "$state" == off || "$state" == required ]] ||
            fail "invalid application state for $id: $state"
        app_ids+=("$id"); app_groups+=("$group"); app_labels+=("$label")
        app_states+=("$state"); app_prerequisites+=("${prerequisites:-}")
    done <"$catalog_dir/applications.tsv"
    load_ai_skill_applications

    [[ -r "$catalog_dir/platforms/$os.tsv" ]] || fail "unsupported catalog platform: $os"
    while IFS=$'\t' read -r id action_provider action_role action_kind action_value action_option; do
        [[ -n "$id$action_provider$action_role$action_kind$action_value${action_option:-}" ]] || continue
        find_value_index "$id" "${app_ids[@]}" >/dev/null 2>&1 || fail "unknown application in $os adapter catalog: $id"
        valid_id "$action_provider" || fail "invalid provider $action_provider for $id"
        case "$action_role" in payload|support|effect) ;; *) fail "invalid action role $action_role for $id" ;; esac
        case "$action_kind" in
            provided|apt-package|pacman-package|brew-cask|brew-tap|installer|command-alias)
                [[ -z "${action_option:-}" ]] || fail "invalid option for $action_kind on $id: $action_option" ;;
            brew-formula)
                [[ -z "${action_option:-}" || "$action_option" == trusted=true ]] ||
                    fail "invalid option for $action_kind on $id: $action_option" ;;
            npm-package)
                [[ -z "${action_option:-}" || "$action_option" == ignore-scripts ]] ||
                    fail "invalid option for $action_kind on $id: $action_option" ;;
            cargo-package)
                [[ -z "${action_option:-}" || "$action_option" == missing-only ]] ||
                    fail "invalid option for $action_kind on $id: $action_option" ;;
            ai-skill)
                valid_ai_skill_source "$action_value" || fail "invalid AI skill source for $id: $action_value"
                valid_ai_skill_name "${action_option:-}" || fail "invalid AI skill name for $id: ${action_option:-}" ;;
            *) fail "unsupported adapter $action_kind for $id" ;;
        esac
        action_apps+=("$id"); action_providers+=("$action_provider"); action_roles+=("$action_role")
        action_kinds+=("$action_kind"); action_values+=("$action_value")
        action_options+=("${action_option:-}")
    done <"$catalog_dir/platforms/$os.tsv"

    for action_index in "${!ai_skill_names[@]}"; do
        action_apps+=("ai-skills.${ai_skill_names[$action_index]}")
        action_providers+=(skills); action_roles+=(payload); action_kinds+=(ai-skill)
        action_values+=("${ai_skill_sources[$action_index]}")
        action_options+=("${ai_skill_names[$action_index]}")
    done

    if [[ -r "$catalog_dir/removals.tsv" ]]; then
        while IFS=$'\t' read -r removal_os id removal_method removal_target removal_option; do
            [[ -n "$removal_os$id$removal_method$removal_target${removal_option:-}" ]] || continue
            case "$removal_os" in macos|ubuntu|debian|arch) ;; *) fail "invalid removal platform: $removal_os" ;; esac
            find_value_index "$id" "${app_ids[@]}" >/dev/null 2>&1 || fail "unknown removal application: $id"
            case "$removal_method" in
                apt-package|pacman-package|brew-formula|brew-cask|npm-package|cargo-package|ai-skill|path|payload-tree|service|managed-file|alias|retain|retain-effect) ;;
                *) fail "unsupported removal method $removal_method for $id" ;;
            esac
            if [[ "$removal_method" == path || "$removal_method" == payload-tree || "$removal_method" == managed-file || "$removal_method" == alias || "$removal_method" == retain ]]; then
                case "$removal_target" in
                    /*|\~/*) ;;
                    *) fail "removal target must be absolute or home-relative for $id" ;;
                esac
                case "$removal_target" in *'..'*|*'*'*|*'?'*|*'['*) fail "unsafe removal target for $id" ;; esac
            fi
            for removal_index in "${!removal_apps[@]}"; do
                if [[ "${removal_oses[$removal_index]}" == "$removal_os" && "${removal_apps[$removal_index]}" == "$id" &&
                      "${removal_methods[$removal_index]}" == "$removal_method" && "${removal_targets[$removal_index]}" == "$removal_target" ]]; then
                    fail "duplicate removal target for $id: $removal_method $removal_target"
                fi
            done
            removal_oses+=("$removal_os"); removal_apps+=("$id"); removal_methods+=("$removal_method")
            removal_targets+=("$removal_target"); removal_options+=("${removal_option:-}")
        done <"$catalog_dir/removals.tsv"
    fi

    validate_references_and_cycles
    validate_provider_completeness
    validate_required_coverage
}

validate_references_and_cycles() {
    local index prerequisites prerequisite
    index=0
    while ((index < ${#app_ids[@]})); do
        prerequisites=${app_prerequisites[$index]}
        if [[ -n "$prerequisites" ]]; then
            local old_ifs=$IFS
            IFS=','
            for prerequisite in $prerequisites; do
                find_value_index "$prerequisite" "${app_ids[@]}" >/dev/null 2>&1 ||
                    fail "unknown prerequisite $prerequisite for ${app_ids[$index]}"
            done
            IFS=$old_ifs
        fi
        check_dependency_cycle "${app_ids[$index]}" ""
        index=$((index + 1))
    done
}

check_dependency_cycle() {
    local id=$1 path=$2 index prerequisites prerequisite old_ifs
    case "$path" in
        *"|$id|"*) fail "dependency cycle involving $id" ;;
    esac
    index=$(find_value_index "$id" "${app_ids[@]}") || return 1
    prerequisites=${app_prerequisites[$index]}
    [[ -n "$prerequisites" ]] || return 0
    old_ifs=$IFS
    IFS=','
    for prerequisite in $prerequisites; do
        check_dependency_cycle "$prerequisite" "$path|$id|"
    done
    IFS=$old_ifs
}

validate_provider_completeness() {
    local index provider_index payload_found
    for index in "${!action_apps[@]}"; do
        case "${action_roles[$index]}:${action_kinds[$index]}" in
            payload:brew-tap|payload:command-alias|support:installer|support:command-alias)
                fail "invalid ${action_roles[$index]} action ${action_kinds[$index]} for ${action_apps[$index]}" ;;
        esac
        payload_found=0
        for provider_index in "${!action_apps[@]}"; do
            if [[ "${action_apps[$provider_index]}" == "${action_apps[$index]}" &&
                  "${action_providers[$provider_index]}" == "${action_providers[$index]}" &&
                  "${action_roles[$provider_index]}" == payload ]]; then payload_found=1; break; fi
        done
        [[ "$payload_found" == 1 ]] || fail "provider ${action_providers[$index]} for ${action_apps[$index]} has no payload"
    done
}

app_is_available() {
    local id=$1 index
    for index in "${!action_apps[@]}"; do
        [[ "${action_apps[$index]}" == "$id" && "${action_roles[$index]}" == payload ]] && return 0
    done
    return 1
}

validate_required_coverage() {
    local index=0
    while ((index < ${#app_ids[@]})); do
        if [[ "${app_states[$index]}" == required ]] && ! app_is_available "${app_ids[$index]}"; then
            fail "required application ${app_ids[$index]} has no platform adapter"
        fi
        index=$((index + 1))
    done
}

initialize_selection() {
    local mode=$1 index=0
    step_selection=(); group_selection=(); app_overrides=()
    while ((index < ${#step_ids[@]})); do
        if [[ "$mode" == full ]]; then step_selection+=(on); else step_selection+=("${step_defaults[$index]}"); fi
        index=$((index + 1))
    done
    index=0
    while ((index < ${#group_ids[@]})); do
        if [[ "$mode" == full ]]; then group_selection+=(on); else group_selection+=("${group_defaults[$index]}"); fi
        index=$((index + 1))
    done
    index=0
    while ((index < ${#app_ids[@]})); do app_overrides+=(""); index=$((index + 1)); done
}

parse_record() {
    local path=$1 strict=$2 line key value line_number=0 format_seen=0 kind identifier index
    local -a seen_record_keys=()
    [[ -r "$path" ]] || { [[ "$strict" == true ]] && fail "cannot read plan record: $path"; return 1; }
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_number=$((line_number + 1))
        [[ -n "$line" ]] || continue
        case "$line" in
            *=*) key=${line%%=*}; value=${line#*=} ;;
            *) [[ "$strict" == true ]] && fail "malformed plan record line $line_number"; return 1 ;;
        esac
        if find_value_index "$key" "${seen_record_keys[@]}" >/dev/null 2>&1; then
            [[ "$strict" == true ]] && fail "duplicate plan record key: $key"
            return 1
        fi
        seen_record_keys+=("$key")
        if [[ "$key" == format ]]; then
            [[ "$value" == 1 && "$format_seen" == 0 ]] || {
                [[ "$strict" == true ]] && fail "unsupported or duplicate plan record format"; return 1;
            }
            format_seen=1
            continue
        fi
        [[ "$value" == on || "$value" == off ]] || {
            [[ "$strict" == true ]] && fail "invalid plan record value on line $line_number"; return 1;
        }
        kind=${key%%.*}; identifier=${key#*.}
        [[ "$identifier" != "$key" ]] || { [[ "$strict" == true ]] && fail "invalid plan record key: $key"; return 1; }
        case "$kind" in
            step)
                if index=$(find_value_index "$identifier" "${step_ids[@]}"); then step_selection[$index]=$value
                else warn "ignoring stale step $identifier"; fi ;;
            group)
                if index=$(find_value_index "$identifier" "${group_ids[@]}"); then
                    if [[ "$identifier" == foundation && "$value" == off ]]; then
                        warn "Foundation group cannot be disabled"
                        group_selection[$index]=on
                    else
                        group_selection[$index]=$value
                    fi
                else warn "ignoring stale group $identifier"; fi ;;
            app)
                if index=$(find_value_index "$identifier" "${app_ids[@]}"); then
                    if [[ "${app_states[$index]}" == required && "$value" == off ]]; then
                        warn "required application $identifier cannot be disabled"
                        app_overrides[$index]=on
                    else
                        app_overrides[$index]=$value
                    fi
                else warn "ignoring stale application $identifier"; fi ;;
            *) [[ "$strict" == true ]] && fail "invalid plan record key: $key"; return 1 ;;
        esac
    done <"$path"
    [[ "$format_seen" == 1 ]] || { [[ "$strict" == true ]] && fail "plan record format is missing"; return 1; }
}

resolve_app_selection() {
    local index=0 group_index selected
    app_selection=()
    while ((index < ${#app_ids[@]})); do
        if ! app_is_available "${app_ids[$index]}"; then
            selected=off
        elif [[ "${app_states[$index]}" == required ]]; then
            selected=on
        elif [[ -n "${app_overrides[$index]}" ]]; then
            selected=${app_overrides[$index]}
        else
            group_index=$(find_value_index "${app_groups[$index]}" "${group_ids[@]}")
            selected=${group_selection[$group_index]}
            [[ "${app_states[$index]}" != off ]] || selected=off
        fi
        app_selection+=("$selected")
        index=$((index + 1))
    done
    index=0
    while ((index < ${#app_ids[@]})); do
        [[ "${app_selection[$index]}" != on ]] || select_prerequisites "${app_ids[$index]}"
        index=$((index + 1))
    done
}

select_prerequisites() {
    local id=$1 index prerequisites prerequisite old_ifs prerequisite_index
    index=$(find_value_index "$id" "${app_ids[@]}") || return 1
    prerequisites=${app_prerequisites[$index]}
    [[ -n "$prerequisites" ]] || return 0
    old_ifs=$IFS
    IFS=','
    for prerequisite in $prerequisites; do
        prerequisite_index=$(find_value_index "$prerequisite" "${app_ids[@]}") || continue
        if ! app_is_available "$prerequisite"; then fail "selected application $id requires unavailable $prerequisite"; fi
        app_selection[$prerequisite_index]=on
        select_prerequisites "$prerequisite"
    done
    IFS=$old_ifs
}

write_resolved_plan() {
    local os=$1 output=$2 index=0 group_index availability action_index
    mkdir -p "$(dirname "$output")"
    : >"$output"
    printf 'format\t1\n' >>"$output"
    printf 'os\t%s\n' "$os" >>"$output"
    while ((index < ${#step_ids[@]})); do
        printf 'step\t%s\t%s\t%s\t%s\n' "${step_ids[$index]}" "${step_selection[$index]}" \
            "${step_orders[$index]}" "${step_labels[$index]}" >>"$output"
        index=$((index + 1))
    done
    index=0
    while ((index < ${#group_ids[@]})); do
        availability=unavailable
        for group_index in "${!app_ids[@]}"; do
            if [[ "${app_groups[$group_index]}" == "${group_ids[$index]}" ]] && app_is_available "${app_ids[$group_index]}"; then
                availability=available
                break
            fi
        done
        printf 'group\t%s\t%s\t%s\t%s\t%s\n' "${group_ids[$index]}" "${group_selection[$index]}" \
            "${group_orders[$index]}" "${group_labels[$index]}" "$availability" >>"$output"
        index=$((index + 1))
    done
    index=0
    while ((index < ${#app_ids[@]})); do
        if app_is_available "${app_ids[$index]}"; then
            if [[ "${app_states[$index]}" == required ]]; then availability=required; else availability=optional; fi
            printf 'app\t%s\t%s\t%s\t%s\t%s\n' "${app_ids[$index]}" "${app_selection[$index]}" \
                "$availability" "${app_groups[$index]}" "${app_labels[$index]}" >>"$output"
        fi
        index=$((index + 1))
    done
    index=0
    while ((index < ${#app_ids[@]})); do
        if [[ "${app_selection[$index]}" == on && -n "${app_prerequisites[$index]}" ]]; then
            local prerequisite old_ifs=$IFS
            IFS=','
            for prerequisite in ${app_prerequisites[$index]}; do
                printf 'dependency\t%s\t%s\n' "${app_ids[$index]}" "$prerequisite" >>"$output"
            done
            IFS=$old_ifs
        fi
        index=$((index + 1))
    done
    action_index=0
    while ((action_index < ${#action_apps[@]})); do
        index=$(find_value_index "${action_apps[$action_index]}" "${app_ids[@]}")
        if [[ "${app_selection[$index]}" == on ]]; then
            printf 'action\t%s\t%s\t%s\t%s\n' "${action_apps[$action_index]}" \
                "${action_kinds[$action_index]}" "${action_values[$action_index]}" \
                "${action_options[$action_index]}" >>"$output"
        fi
        action_index=$((action_index + 1))
    done
    index=0
    while ((index < ${#step_ids[@]})); do
        if [[ "${step_selection[$index]}" == on && "${step_adapters[$index]}" != dependencies ]]; then
            printf 'step-action\t%s\t%s\t%s\t\n' "${step_ids[$index]}" \
                "${step_adapters[$index]}" "${step_arguments[$index]}" >>"$output"
        fi
        index=$((index + 1))
    done
}

render_review() {
    local output=$1 type id selected order label rest
    echo 'Resolved installation plan:'
    while IFS=$'\t' read -r type id selected order label rest; do
        case "$type" in
            step) printf '  %s. [%s] %s\n' "$order" "$selected" "$label" ;;
            group) [[ "$selected" == on ]] && printf '       [group] %s\n' "$label" ;;
            app) [[ "$selected" == on ]] && printf '           [app] %s\n' "$rest" ;;
        esac
    done <"$output"
}

write_plan_record() {
    local output=$1 index=0
    {
        echo 'format=1'
        while ((index < ${#step_ids[@]})); do
            printf 'step.%s=%s\n' "${step_ids[$index]}" "${step_selection[$index]}"
            index=$((index + 1))
        done
        index=0
        while ((index < ${#group_ids[@]})); do
            printf 'group.%s=%s\n' "${group_ids[$index]}" "${group_selection[$index]}"
            index=$((index + 1))
        done
        index=0
        while ((index < ${#app_ids[@]})); do
            if [[ -n "${app_overrides[$index]}" ]]; then
                printf 'app.%s=%s\n' "${app_ids[$index]}" "${app_overrides[$index]}"
            fi
            index=$((index + 1))
        done
    } >"$output"
}

save_default_record() {
    local source=$1 directory temporary
    directory=$(dirname "$default_record")
    mkdir -p "$directory"
    temporary=$(mktemp "$directory/.installation-plan.XXXXXX")
    chmod 600 "$temporary"
    cp "$source" "$temporary"
    mv -f "$temporary" "$default_record"
}

write_observation_snapshot() {
    local os=$1 output=$2 index=0 total=0 settled=0
    total=${#app_ids[@]}
    collect_versions=1
    emit_event run-start "$total"
    prepare_version_inventory "$os"
    { printf 'format\t1\n'; printf 'os\t%s\n' "$os"; } >"$output"
    index=0
    while ((index < ${#app_ids[@]})); do
        emit_event operation-start "inspect:${app_ids[$index]}" "${app_labels[$index]}" indeterminate
        if app_is_available "${app_ids[$index]}"; then
            inspect_app "$os" "$index" >>"$output"
        else
            if [[ "${app_states[$index]}" == required ]]; then policy=required; else policy=optional; fi
            printf 'observation\t%s\tunavailable\tunknown\tunverified\t%s\tdisabled\tdisabled\t%s\t%s\tno provider on %s\n' \
                "${app_ids[$index]}" "$policy" "${app_groups[$index]}" "${app_labels[$index]}" "$os" >>"$output"
        fi
        settled=$((settled + 1))
        emit_event operation-settled "inspect:${app_ids[$index]}" succeeded "$settled" "$total"
        index=$((index + 1))
    done
    emit_event run-settled succeeded "$settled" "$total"
    collect_versions=0
    [[ -z "$version_inventory_dir" ]] || rm -rf "$version_inventory_dir"
    version_inventory_dir=
    version_inventory_ready=0
}

write_outcome_selection_draft() {
    local output=$1 index=0 prerequisite old_ifs
    printf 'format\t1\n' >"$output"
    while ((index < ${#group_ids[@]})); do
        printf 'group\t%s\t%s\n' "${group_ids[$index]}" "${group_labels[$index]}" >>"$output"
        index=$((index + 1))
    done
    index=0
    while ((index < ${#step_ids[@]})); do
        printf 'step\t%s\t%s\t%s\n' "${step_ids[$index]}" "${step_selection[$index]}" "${step_labels[$index]}" >>"$output"
        index=$((index + 1))
    done
    index=0
    while ((index < ${#app_ids[@]})); do
        if app_is_available "${app_ids[$index]}"; then
            if [[ "${app_selection[$index]}" == on ]]; then outcome=ensure; else outcome=leave; fi
            printf 'outcome\t%s\t%s\n' "${app_ids[$index]}" "$outcome" >>"$output"
        fi
        if app_is_available "${app_ids[$index]}"; then
            old_ifs=$IFS; IFS=','
            for prerequisite in ${app_prerequisites[$index]}; do
                [[ -z "$prerequisite" ]] || printf 'dependency\t%s\t%s\n' "${app_ids[$index]}" "$prerequisite" >>"$output"
            done
            IFS=$old_ifs
        fi
        index=$((index + 1))
    done
}

save_outcome_defaults() {
    local temporary index=0
    while ((index < ${#app_ids[@]})); do
        if [[ "${app_states[$index]}" == required ]]; then
            app_overrides[$index]=on
        elif [[ "${app_outcomes[$index]}" == ensure ]]; then
            app_overrides[$index]=on
        else
            app_overrides[$index]=off
        fi
        index=$((index + 1))
    done
    temporary=$(mktemp "${TMPDIR:-/tmp}/dotfiles-plan-defaults.XXXXXX")
    write_plan_record "$temporary"
    save_default_record "$temporary"
    rm -f "$temporary"
}

prepare_visual_outcome_run() {
    local os=$1 output=$2 approval=$3 observations=${4:-} own_observations=0 selection draft
    if [[ -z "$observations" ]]; then observations=$(mktemp "${TMPDIR:-/tmp}/dotfiles-observations.XXXXXX"); own_observations=1; fi
    selection=$(mktemp "${TMPDIR:-/tmp}/dotfiles-outcomes.XXXXXX")
    draft=$(mktemp "${TMPDIR:-/tmp}/dotfiles-outcome-draft.XXXXXX")
    if [[ "$own_observations" == 1 ]]; then write_observation_snapshot "$os" "$observations"; fi
    write_outcome_selection_draft "$draft"
    if ! "$root_dir/tools/run-install-tui" choose --observations "$observations" --selection "$draft" --output "$selection"; then
        [[ "$own_observations" != 1 ]] || rm -f "$observations"
        rm -f "$selection" "$draft"; return 1
    fi
    prepared_os=$os
    load_observations "$observations"
    parse_outcome_selection "$selection"
    prepare_outcome_dependencies
    write_outcome_plan "$output" "$os"
    if ! "$root_dir/tools/run-install-tui" confirm --plan "$output" --output "$approval"; then
        [[ "$own_observations" != 1 ]] || rm -f "$observations"
        rm -f "$selection" "$draft" "$approval"; return 1
    fi
    save_outcome_defaults
    [[ "$own_observations" != 1 ]] || rm -f "$observations"
    rm -f "$selection" "$draft"
}

installer_probe_command() {
    case "$1" in
        bitwarden) echo bitwarden ;; chrome) echo google-chrome ;; code) echo code ;;
        discord) echo discord ;; docker) echo docker ;; ghostty) echo ghostty ;;
        lazygit) echo lazygit ;; neovim) echo nvim ;; obsidian) echo obsidian ;;
        bun) echo bun ;; node) echo node ;; rust) echo rustc ;;
        java) echo java ;; gradle) echo gradle ;; kotlin) echo kotlin ;; maven) echo mvn ;;
        claude_code) echo claude ;; herdr) echo herdr ;;
        lazydocker) echo lazydocker ;; yazi) echo yazi ;; locale) echo locale ;;
        *) echo "$1" ;;
    esac
}

installer_receipt_package() {
    local os=$1 installer=$2
    case "$os:$installer" in
        debian:bitwarden|ubuntu:bitwarden) printf 'bitwarden\n' ;;
        debian:chrome|ubuntu:chrome) printf 'google-chrome-stable\n' ;;
        debian:code|ubuntu:code) printf 'code\n' ;;
        debian:discord|ubuntu:discord) printf 'discord\n' ;;
        debian:obsidian|ubuntu:obsidian) printf 'obsidian\n' ;;
        *) return 1 ;;
    esac
}

installer_receipt_version() {
    local os=$1 installer=$2 target=$3 package output version=
    package=$(installer_receipt_package "$os" "$installer" 2>/dev/null || true)
    if [[ -n "$package" ]]; then
        version=$(dpkg-query -W -f='${Version}' "$package" 2>/dev/null || true)
    else
        case "$installer" in
            bun|chrome|claude_code|code|docker|ghostty|gradle|herdr|java|kotlin|lazydocker|lazygit|locale|maven|neovim|node|rust|uv|yazi|zed)
                output=$("$target" --version 2>/dev/null || true)
                version=${output%%$'\n'*}
                ;;
        esac
    fi
    [[ -n "$version" ]] || version=unknown
    printf '%s\n' "${version//$'\t'/ }"
}

catalog_uses_action_kind() {
    local expected=$1 kind
    for kind in "${action_kinds[@]}"; do [[ "$kind" != "$expected" ]] || return 0; done
    return 1
}

inventory_lookup() {
    local file=$1 key=$2
    [[ -r "$file" ]] || return 1
    awk -F '\t' -v key="$key" '$1 == key { print $2; found=1; exit } END { if (!found) exit 1 }' "$file"
}

inventory_known() {
    [[ -e "$version_inventory_dir/$1-known" ]]
}

write_homebrew_inventory_aliases() {
    local json=$1 output=$2
    awk '
        $1 == "\"formulae\":" { kind="brew-formula" }
        $1 == "\"casks\":" { kind="brew-cask" }
        $1 == "\"name\":" || $1 == "\"token\":" {
            short_name=$2; gsub(/^\"|\",?$/, "", short_name)
        }
        $1 == "\"full_name\":" || $1 == "\"full_token\":" {
            full_name=$2; gsub(/^\"|\",?$/, "", full_name)
            if (kind != "" && short_name != "" && full_name != short_name) {
                print kind "\t" full_name "\t" short_name
            }
        }
    ' "$json" >"$output"
}

append_homebrew_inventory_aliases() {
    local aliases=$1 inventory=$2 kind full_name short_name version
    [[ -r "$aliases" && -r "$inventory" ]] || return 0
    while IFS=$'\t' read -r kind full_name short_name; do
        [[ -n "$kind" && -n "$full_name" && -n "$short_name" ]] || continue
        version=$(inventory_lookup "$inventory" "$kind:$short_name" 2>/dev/null || true)
        [[ -z "$version" ]] || printf '%s:%s\t%s\n' "$kind" "$full_name" "$version" >>"$inventory"
    done <"$aliases"
}

parse_npm_inventory() {
    local input=$1 output=$2
    command -v node >/dev/null 2>&1 || return 1
    node -e '
const fs = require("fs");
const data = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
for (const [name, details] of Object.entries(data.dependencies || {})) {
  if (details && details.version) console.log(`${name}\t${details.version}`);
}
' "$input" >"$output"
}

parse_npm_updates() {
    local input=$1 output=$2
    command -v node >/dev/null 2>&1 || return 1
    node -e '
const fs = require("fs");
const data = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
for (const [name, details] of Object.entries(data || {})) {
  if (details && details.latest) console.log(`${name}\t${details.latest}`);
}
' "$input" >"$output"
}

refresh_npm_update_inventory() {
    local output=$1 raw pid attempts=0 limit=${DOTFILES_UPDATE_CHECK_TIMEOUT_TENTHS:-30} status=0
    [[ "$limit" =~ ^[0-9]+$ ]] || limit=30
    raw=$(mktemp "$version_inventory_dir/npm-outdated.XXXXXX")
    (
        if npm outdated --global --json >"$raw" 2>/dev/null; then
            exit 0
        else
            status=$?
            [[ "$status" == 1 ]]
        fi
    ) &
    pid=$!
    while kill -0 "$pid" 2>/dev/null && ((attempts < limit)); do
        sleep 0.1
        attempts=$((attempts + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
        rm -f "$raw"
        return 1
    fi
    if ! wait "$pid" || ! parse_npm_updates "$raw" "$output"; then
        rm -f "$raw"
        return 1
    fi
    rm -f "$raw"
}

prepare_npm_update_inventory() {
    local output=$1 cache_dir cache_file temporary ttl=${DOTFILES_UPDATE_CACHE_MINUTES:-360}
    [[ "$ttl" =~ ^[0-9]+$ ]] || ttl=360
    cache_dir=$state_home/dotfiles/update-cache
    cache_file=$cache_dir/npm.tsv
    if [[ -f "$cache_file" ]] && find "$cache_file" -mmin "-$ttl" -print 2>/dev/null | grep -q .; then
        cp "$cache_file" "$output"
        return 0
    fi
    mkdir -p "$cache_dir"
    chmod 700 "$cache_dir" 2>/dev/null || true
    temporary=$(mktemp "$cache_dir/.npm.XXXXXX")
    if refresh_npm_update_inventory "$temporary"; then
        chmod 600 "$temporary"
        mv -f "$temporary" "$cache_file"
        cp "$cache_file" "$output"
        return 0
    fi
    rm -f "$temporary"
    [[ -f "$cache_file" ]] || return 1
    cp "$cache_file" "$output"
}

prepare_version_inventory() {
    local os=$1 raw file
    [[ "$version_inventory_ready" == 0 ]] || return 0
    version_inventory_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-version-inventory.XXXXXX")
    for file in apt-installed apt-updates pacman-installed pacman-updates brew-installed brew-updates npm-installed npm-updates cargo-installed ai-skills-installed; do
        : >"$version_inventory_dir/$file"
    done
    if [[ -n "${DOTFILES_INSTALL_PLAN_VERSION_INSPECTOR:-}" ]]; then
        version_inventory_ready=1
        return 0
    fi

    if catalog_uses_action_kind apt-package && command -v dpkg-query >/dev/null 2>&1; then
        raw=$version_inventory_dir/dpkg.raw
        if dpkg-query -W -f='${binary:Package}\t${Version}\n' >"$raw" 2>/dev/null; then
            awk -F '\t' '{ sub(/:[^:]+$/, "", $1); print $1 "\t" $2 }' "$raw" >"$version_inventory_dir/apt-installed"
            : >"$version_inventory_dir/apt-installed-known"
        fi
        if command -v apt >/dev/null 2>&1 && LC_ALL=C apt list --upgradable >"$raw" 2>/dev/null; then
            awk '$1 != "Listing..." { split($1, name, "/"); if (name[1] && $2) print name[1] "\t" $2 }' \
                "$raw" >"$version_inventory_dir/apt-updates"
            : >"$version_inventory_dir/apt-updates-known"
        fi
    fi

    if catalog_uses_action_kind pacman-package && command -v pacman >/dev/null 2>&1; then
        if LC_ALL=C pacman -Q >"$version_inventory_dir/pacman-installed.raw" 2>/dev/null; then
            awk '{ print $1 "\t" $2 }' "$version_inventory_dir/pacman-installed.raw" >"$version_inventory_dir/pacman-installed"
            : >"$version_inventory_dir/pacman-installed-known"
        fi
        if LC_ALL=C pacman -Qu >"$version_inventory_dir/pacman-updates.raw" 2>/dev/null; then
            awk '{ print $1 "\t" $4 }' "$version_inventory_dir/pacman-updates.raw" >"$version_inventory_dir/pacman-updates"
            : >"$version_inventory_dir/pacman-updates-known"
        fi
    fi

    if { catalog_uses_action_kind brew-formula || catalog_uses_action_kind brew-cask; } && command -v brew >/dev/null 2>&1; then
        if HOMEBREW_NO_AUTO_UPDATE=1 brew info --json=v2 --installed >"$version_inventory_dir/brew-info.raw" 2>/dev/null; then
            write_homebrew_inventory_aliases "$version_inventory_dir/brew-info.raw" "$version_inventory_dir/brew-aliases"
        fi
        if HOMEBREW_NO_AUTO_UPDATE=1 brew list --formula --versions >"$version_inventory_dir/brew-formula.raw" 2>/dev/null; then
            awk '{ print "brew-formula:" $1 "\t" $NF }' "$version_inventory_dir/brew-formula.raw" >>"$version_inventory_dir/brew-installed"
            : >"$version_inventory_dir/brew-installed-known"
        fi
        if HOMEBREW_NO_AUTO_UPDATE=1 brew list --cask --versions >"$version_inventory_dir/brew-cask.raw" 2>/dev/null; then
            awk '{ print "brew-cask:" $1 "\t" $NF }' "$version_inventory_dir/brew-cask.raw" >>"$version_inventory_dir/brew-installed"
            : >"$version_inventory_dir/brew-installed-known"
        fi
        append_homebrew_inventory_aliases "$version_inventory_dir/brew-aliases" "$version_inventory_dir/brew-installed"
        if LC_ALL=C HOMEBREW_NO_AUTO_UPDATE=1 brew outdated --formula --verbose >"$version_inventory_dir/brew-formula-outdated.raw" 2>/dev/null &&
           LC_ALL=C HOMEBREW_NO_AUTO_UPDATE=1 brew outdated --cask --verbose >"$version_inventory_dir/brew-cask-outdated.raw" 2>/dev/null; then
            awk 'NF >= 4 && ($(NF-1) == "<" || $(NF-1) == "!=") { print "brew-formula:" $1 "\t" $NF }' \
                "$version_inventory_dir/brew-formula-outdated.raw" >"$version_inventory_dir/brew-updates"
            awk 'NF >= 4 && ($(NF-1) == "<" || $(NF-1) == "!=") { print "brew-cask:" $1 "\t" $NF }' \
                "$version_inventory_dir/brew-cask-outdated.raw" >>"$version_inventory_dir/brew-updates"
            append_homebrew_inventory_aliases "$version_inventory_dir/brew-aliases" "$version_inventory_dir/brew-updates"
            : >"$version_inventory_dir/brew-updates-known"
        fi
    fi

    if catalog_uses_action_kind npm-package && command -v npm >/dev/null 2>&1; then
        raw=$version_inventory_dir/npm-list.raw
        npm list --global --depth=0 --json >"$raw" 2>/dev/null || true
        if [[ -s "$raw" ]] && parse_npm_inventory "$raw" "$version_inventory_dir/npm-installed"; then
            : >"$version_inventory_dir/npm-installed-known"
        fi
        if prepare_npm_update_inventory "$version_inventory_dir/npm-updates"; then
            : >"$version_inventory_dir/npm-updates-known"
        fi
    fi

    if catalog_uses_action_kind cargo-package && command -v cargo >/dev/null 2>&1; then
        if cargo install --list >"$version_inventory_dir/cargo-list.raw" 2>/dev/null; then
            awk '/^[^[:space:]].* v[^:]+:$/ { version=$2; sub(/^v/, "", version); sub(/:$/, "", version); print $1 "\t" version }' \
                "$version_inventory_dir/cargo-list.raw" >"$version_inventory_dir/cargo-installed"
            : >"$version_inventory_dir/cargo-installed-known"
        fi
    fi

    if catalog_uses_action_kind ai-skill; then
        if write_ai_skill_inventory "$version_inventory_dir/ai-skills-installed"; then
            : >"$version_inventory_dir/ai-skills-installed-known"
        fi
    fi
    version_inventory_ready=1
}

receipt_version_for_app() {
    local os=$1 app=$2 installer=$3 receipt type first second
    validated_receipt_target "$os" "$app" "$installer" >/dev/null 2>&1 || return 1
    receipt=$(receipt_path_for_app "$os" "$app")
    while IFS=$'\t' read -r type first second; do
        if [[ "$type" == version && -n "$first" && -z "${second:-}" && "$first" != unknown ]]; then
            printf '%s\n' "$first"
            return 0
        fi
    done <"$receipt"
    return 1
}

sanitize_version() {
    LC_ALL=C printf '%s' "$1" | LC_ALL=C tr -cd '[:print:]'
}

real_action_version() {
    local os=$1 app=$2 kind=$3 value=$4 option=$5 installed='' latest='' status=unknown target package output
    case "$kind" in
        apt-package)
            installed=$(inventory_lookup "$version_inventory_dir/apt-installed" "$value" 2>/dev/null || true)
            latest=$(inventory_lookup "$version_inventory_dir/apt-updates" "$value" 2>/dev/null || true)
            inventory_known apt-updates && status=current
            ;;
        pacman-package)
            installed=$(inventory_lookup "$version_inventory_dir/pacman-installed" "$value" 2>/dev/null || true)
            latest=$(inventory_lookup "$version_inventory_dir/pacman-updates" "$value" 2>/dev/null || true)
            inventory_known pacman-updates && status=current
            ;;
        brew-formula|brew-cask)
            installed=$(inventory_lookup "$version_inventory_dir/brew-installed" "$kind:$value" 2>/dev/null || true)
            latest=$(inventory_lookup "$version_inventory_dir/brew-updates" "$kind:$value" 2>/dev/null || true)
            inventory_known brew-updates && status=current
            ;;
        npm-package)
            installed=$(inventory_lookup "$version_inventory_dir/npm-installed" "$value" 2>/dev/null || true)
            latest=$(inventory_lookup "$version_inventory_dir/npm-updates" "$value" 2>/dev/null || true)
            inventory_known npm-updates && status=current
            ;;
        cargo-package)
            installed=$(inventory_lookup "$version_inventory_dir/cargo-installed" "$value" 2>/dev/null || true)
            ;;
        installer)
            installed=$(receipt_version_for_app "$os" "$app" "$value" 2>/dev/null || true)
            if [[ -z "$installed" ]]; then
                package=$(installer_receipt_package "$os" "$value" 2>/dev/null || true)
                if [[ -n "$package" ]]; then
                    installed=$(inventory_lookup "$version_inventory_dir/apt-installed" "$package" 2>/dev/null || true)
                    latest=$(inventory_lookup "$version_inventory_dir/apt-updates" "$package" 2>/dev/null || true)
                    inventory_known apt-updates && status=current
                elif target=$(command -v "$(installer_probe_command "$value")" 2>/dev/null); then
                    output=$(installer_receipt_version "$os" "$value" "$target")
                    [[ "$output" == unknown ]] || installed=$output
                fi
            fi
            ;;
        provided)
            case "$value" in
                bash) installed=$BASH_VERSION ;;
                curl|git|zsh)
                    if target=$(command -v "$value" 2>/dev/null); then
                        output=$("$target" --version 2>/dev/null || true)
                        installed=${output%%$'\n'*}
                    fi ;;
            esac
            ;;
    esac
    if [[ -n "$latest" && "$latest" != "$installed" ]]; then status=update; else latest=; fi
    installed=$(sanitize_version "$installed")
    latest=$(sanitize_version "$latest")
    printf '%s\t%s\t%s\n' "${installed:--}" "${latest:--}" "$status"
}

inspect_action_version() {
    local os=$1 app=$2 kind=$3 value=$4 option=$5
    if [[ -n "${DOTFILES_INSTALL_PLAN_VERSION_INSPECTOR:-}" ]]; then
        "$DOTFILES_INSTALL_PLAN_VERSION_INSPECTOR" "$kind" "$value" "$option" "$os" "$app"
    else
        real_action_version "$os" "$app" "$kind" "$value" "$option"
    fi
}

ai_skill_lock_path() {
    printf '%s\n' "${DOTFILES_AI_SKILLS_LOCK:-$HOME/.agents/.skill-lock.json}"
}

write_ai_skill_inventory() {
    local output=$1 lock
    lock=$(ai_skill_lock_path)
    [[ -r "$lock" ]] || return 1
    if command -v node >/dev/null 2>&1; then
        node -e '
const fs = require("fs");
const lockPath = process.argv[1];
const data = JSON.parse(fs.readFileSync(lockPath, "utf8"));
for (const [name, details] of Object.entries(data.skills || {})) {
  const sourceUrl = String((details && details.sourceUrl) || "");
  if (sourceUrl && /^[a-z0-9][a-z0-9.-]*$/.test(name)) {
    console.log(`${sourceUrl}\t${name}`);
  }
}
' "$lock" >"$output"
    elif command -v python3 >/dev/null 2>&1; then
        python3 - "$lock" >"$output" <<'PY'
import json
import re
import sys
with open(sys.argv[1], encoding="utf-8") as fh:
    data = json.load(fh)
for name, details in (data.get("skills") or {}).items():
    source_url = str((details or {}).get("sourceUrl") or "")
    if source_url and re.match(r"^[a-z0-9][a-z0-9.-]*$", name):
        print(f"{source_url}\t{name}")
PY
    else
        return 1
    fi
}

ai_skill_inventory_has() {
    local source=$1 skill=$2 file=$3 row_source row_skill
    [[ -r "$file" ]] || return 1
    while IFS=$'\t' read -r row_source row_skill; do
        if [[ "$row_skill" == "$skill" && "${row_source%.git}" == "${source%.git}" ]]; then
            return 0
        fi
    done <"$file"
    return 1
}

ai_skill_is_installed() {
    local source=$1 skill=$2 temporary result=1
    if [[ "$version_inventory_ready" == 1 ]] && inventory_known ai-skills-installed; then
        ai_skill_inventory_has "$source" "$skill" "$version_inventory_dir/ai-skills-installed"
        return $?
    fi
    temporary=$(mktemp "${TMPDIR:-/tmp}/dotfiles-ai-skills.XXXXXX") || return 1
    if write_ai_skill_inventory "$temporary" && ai_skill_inventory_has "$source" "$skill" "$temporary"; then
        result=0
    fi
    rm -f "$temporary"
    return "$result"
}

# Enrich the existing label field so observation format 1 stays compatible with
# the pinned TUI release while the Plan tree gains version information.
versioned_application_label() {
    local label=$1 installed=$2 latest=$3 status=$4
    if [[ "$status" == update && -n "$installed" && -n "$latest" ]]; then
        printf '%s (%s -> %s)\n' "$label" "$installed" "$latest"
    elif [[ -n "$installed" ]]; then
        printf '%s (%s)\n' "$label" "$installed"
    else
        printf '%s\n' "$label"
    fi
}

homebrew_registration_exists() {
    local kind=$1 value=$2 flag=--formula identity_key=full_name info short_name
    [[ "$kind" != brew-cask ]] || { flag=--cask; identity_key=full_token; }
    if [[ "$value" == */* ]]; then
        info=$(HOMEBREW_NO_AUTO_UPDATE=1 brew info --json=v2 "$value" 2>/dev/null) || return 1
        printf '%s\n' "$info" | grep -Fq "\"$identity_key\": \"$value\"" || return 1
        short_name=${value##*/}
        HOMEBREW_NO_AUTO_UPDATE=1 brew list "$flag" "$short_name" >/dev/null 2>&1
    else
        HOMEBREW_NO_AUTO_UPDATE=1 brew list "$flag" "$value" >/dev/null 2>&1
    fi
}

inspect_real_action() {
    local kind=$1 value=$2 option=$3 binary
    case "$kind" in
        provided) printf 'present\tprovided\t%s is provided externally\n' "$value" ;;
        apt-package)
            if [[ "$version_inventory_ready" == 1 ]] && inventory_known apt-installed; then
                if inventory_lookup "$version_inventory_dir/apt-installed" "$value" >/dev/null 2>&1; then
                    printf 'present\tmanaged\t%s is registered by dpkg\n' "$value"
                else printf 'absent\tunverified\t%s is not registered by dpkg\n' "$value"; fi
            elif dpkg-query -W -f='${db:Status-Abbrev}' "$value" 2>/dev/null | grep -q '^ii '; then
                printf 'present\tmanaged\t%s is registered by dpkg\n' "$value"
            else printf 'absent\tunverified\t%s is not registered by dpkg\n' "$value"; fi ;;
        pacman-package)
            if [[ "$version_inventory_ready" == 1 ]] && inventory_known pacman-installed; then
                if inventory_lookup "$version_inventory_dir/pacman-installed" "$value" >/dev/null 2>&1; then
                    printf 'present\tmanaged\t%s is registered by pacman\n' "$value"
                else printf 'absent\tunverified\t%s is not registered by pacman\n' "$value"; fi
            elif pacman -Q "$value" >/dev/null 2>&1; then printf 'present\tmanaged\t%s is registered by pacman\n' "$value"
            else printf 'absent\tunverified\t%s is not registered by pacman\n' "$value"; fi ;;
        brew-formula|brew-cask)
            if [[ "$kind" == brew-cask ]]; then option=--cask; else option=--formula; fi
            if [[ "$version_inventory_ready" == 1 ]] && inventory_known brew-installed; then
                if inventory_lookup "$version_inventory_dir/brew-installed" "$kind:$value" >/dev/null 2>&1; then
                    printf 'present\tmanaged\t%s is registered by Homebrew\n' "$value"
                else printf 'absent\tunverified\t%s is not registered by Homebrew\n' "$value"; fi
            elif command -v brew >/dev/null 2>&1 && homebrew_registration_exists "$kind" "$value"; then
                printf 'present\tmanaged\t%s is registered by Homebrew\n' "$value"
            else printf 'absent\tunverified\t%s is not registered by Homebrew\n' "$value"; fi ;;
        npm-package)
            if [[ "$version_inventory_ready" == 1 ]] && inventory_known npm-installed; then
                if inventory_lookup "$version_inventory_dir/npm-installed" "$value" >/dev/null 2>&1; then
                    printf 'present\tmanaged\t%s is registered by npm\n' "$value"
                else printf 'absent\tunverified\t%s is not registered by npm\n' "$value"; fi
            elif command -v npm >/dev/null 2>&1 && npm list --global --depth=0 "$value" >/dev/null 2>&1; then
                printf 'present\tmanaged\t%s is registered by npm\n' "$value"
            else printf 'absent\tunverified\t%s is not registered by npm\n' "$value"; fi ;;
        cargo-package)
            if [[ "$version_inventory_ready" == 1 ]] && inventory_known cargo-installed; then
                if inventory_lookup "$version_inventory_dir/cargo-installed" "$value" >/dev/null 2>&1; then
                    printf 'present\tmanaged\t%s is registered by Cargo\n' "$value"
                else printf 'absent\tunverified\t%s is not registered by Cargo\n' "$value"; fi
            elif command -v cargo >/dev/null 2>&1 && cargo install --list 2>/dev/null | grep -Eq "^${value//./\\.} v[^:]+:$"; then
                printf 'present\tmanaged\t%s is registered by Cargo\n' "$value"
            else printf 'absent\tunverified\t%s is not registered by Cargo\n' "$value"; fi ;;
        ai-skill)
            if ai_skill_is_installed "$value" "$option"; then
                printf 'present\tmanaged\t%s is installed from %s\n' "$option" "$value"
            else
                printf 'absent\tunverified\t%s is not installed from %s\n' "$option" "$value"
            fi ;;
        installer)
            binary=$(installer_probe_command "$value")
            if command -v "$binary" >/dev/null 2>&1; then
                printf 'present\tunverified\t%s was found without a validated receipt\n' "$binary"
            else printf 'absent\tunverified\t%s was not found\n' "$binary"; fi ;;
        command-alias|brew-tap) printf 'absent\tunverified\tsupport action does not establish presence\n' ;;
        *) printf 'unknown\tunverified\tunsupported inspection adapter %s\n' "$kind" ;;
    esac
}

receipt_path_for_app() {
    printf '%s/dotfiles/receipts/%s/%s.tsv\n' "$state_home" "$1" "$2"
}

validated_receipt_target() {
    local os=$1 app=$2 installer=$3 receipt type first second extra format_seen=0 receipt_app='' receipt_installer='' target='' digest='' version_seen=0 effect_seen=0
    receipt=$(receipt_path_for_app "$os" "$app")
    [[ -r "$receipt" ]] || return 1
    while IFS=$'\t' read -r type first second extra; do
        case "$type" in
            format) [[ "$first" == 1 && "$format_seen" == 0 && -z "${second:-}" ]] || return 1; format_seen=1 ;;
            app) [[ -z "$receipt_app" && -z "${second:-}" ]] || return 1; receipt_app=$first ;;
            installer) [[ -z "$receipt_installer" && -z "${second:-}" ]] || return 1; receipt_installer=$first ;;
            target) [[ -z "$target" && -z "${second:-}" ]] || return 1; target=$first ;;
            sha256) [[ -z "$digest" && "$first" =~ ^[0-9a-f]{64}$ && -z "${second:-}" ]] || return 1; digest=$first ;;
            version) [[ "$version_seen" == 0 && -n "$first" && -z "${second:-}" ]] || return 1; version_seen=1 ;;
            effect) [[ "$effect_seen" == 0 && "$first" == catalog-installer && -z "${second:-}" ]] || return 1; effect_seen=1 ;;
            *) return 1 ;;
        esac
    done <"$receipt"
    [[ "$format_seen" == 1 && "$version_seen" == 1 && "$effect_seen" == 1 && "$receipt_app" == "$app" && "$receipt_installer" == "$installer" && -f "$target" ]] || return 1
    [[ "$(sha256_file "$target")" == "$digest" ]] || return 1
    printf '%s\n' "$target"
}

write_installation_receipt() {
    local os=$1 app=$2 installer=$3 binary target output temporary version
    binary=$(installer_probe_command "$installer")
    target=$(command -v "$binary" 2>/dev/null) || return 0
    [[ -f "$target" ]] || return 0
    version=$(installer_receipt_version "$os" "$installer" "$target")
    output=$(receipt_path_for_app "$os" "$app")
    mkdir -p "$(dirname "$output")"
    temporary=$(mktemp "$(dirname "$output")/.receipt.XXXXXX")
    chmod 600 "$temporary"
    {
        printf 'format\t1\napp\t%s\ninstaller\t%s\nversion\t%s\ntarget\t%s\nsha256\t%s\neffect\tcatalog-installer\n' \
            "$app" "$installer" "$version" "$target" "$(sha256_file "$target")"
    } >"$temporary"
    mv -f "$temporary" "$output"
}

inspect_action() {
    local kind=$1 value=$2 option=$3
    if [[ -n "${DOTFILES_INSTALL_PLAN_INSPECTOR:-}" ]]; then
        "$DOTFILES_INSTALL_PLAN_INSPECTOR" "$kind" "$value" "$option"
    else
        inspect_real_action "$kind" "$value" "$option"
    fi
}

app_has_force_recipe() {
    local os=$1 id=$2 index=0
    while ((index < ${#removal_apps[@]})); do
        if [[ "${removal_oses[$index]}" == "$os" && "${removal_apps[$index]}" == "$id" &&
              "${removal_methods[$index]}" != retain && "${removal_methods[$index]}" != retain-effect ]]; then return 0; fi
        index=$((index + 1))
    done
    return 1
}

record_inspection_mechanism() {
    local kind=$1 target=$2 option=$3 index
    for index in "${!mechanism_kinds[@]}"; do
        if [[ "${mechanism_kinds[$index]}" == "$kind" && "${mechanism_targets[$index]}" == "$target" &&
              "${mechanism_options[$index]}" == "$option" ]]; then return 0; fi
    done
    mechanism_kinds+=("$kind"); mechanism_targets+=("$target"); mechanism_options+=("$option")
}

inspect_app() {
    local os=$1 app_index=$2 id action_index=0 result presence custody evidence receipt_target
    local version_result installed latest action_status formatted_label
    local -a mechanism_kinds=() mechanism_targets=() mechanism_options=()
    id=${app_ids[$app_index]}
    local present_count=0 partial_count=0 absent_count=0 unknown_count=0 managed_count=0 provided_count=0 unverified_count=0 exact_method=0
    local present_managed=0 present_provided=0 present_unverified=0
    local first_evidence='' app_presence app_custody policy exact_capability=disabled force_capability=disabled mechanism_index recipe_index
    local app_installed='' app_latest='' app_update=unknown
    while ((action_index < ${#action_apps[@]})); do
        if [[ "${action_apps[$action_index]}" == "$id" && "${action_roles[$action_index]}" == payload ]]; then
            if result=$(inspect_action "${action_kinds[$action_index]}" "${action_values[$action_index]}" \
                "${action_options[$action_index]}"); then
                IFS=$'\t' read -r presence custody evidence <<<"$result"
            else
                presence=unknown; custody=unverified; evidence="inspection adapter failed"
            fi
            case "$presence" in present) present_count=$((present_count + 1)) ;; partial) partial_count=$((partial_count + 1)) ;; absent) absent_count=$((absent_count + 1)) ;; *) unknown_count=$((unknown_count + 1)) ;; esac
            if [[ "$collect_versions" == 1 && ( "$presence" == present || "$presence" == partial ) ]]; then
                if version_result=$(inspect_action_version "$os" "$id" "${action_kinds[$action_index]}" \
                    "${action_values[$action_index]}" "${action_options[$action_index]}" 2>/dev/null); then
                    IFS=$'\t' read -r installed latest action_status <<<"$version_result"
                    [[ "$installed" == - ]] && installed=
                    [[ "$latest" == - ]] && latest=
                    installed=$(sanitize_version "$installed")
                    latest=$(sanitize_version "$latest")
                    case "$action_status" in update|current|unknown) ;; *) action_status=unknown ;; esac
                    if [[ "$action_status" == update && -n "$installed" && -n "$latest" ]]; then
                        app_installed=$installed; app_latest=$latest; app_update=update
                    elif [[ -z "$app_installed" && -n "$installed" ]]; then
                        app_installed=$installed; app_latest=; app_update=$action_status
                    elif [[ "$app_update" == unknown && "$action_status" == current ]]; then
                        app_update=current
                    fi
                fi
            fi
            if [[ "$presence" == present && "$custody" == unverified && "${action_kinds[$action_index]}" == installer ]] &&
                receipt_target=$(validated_receipt_target "$os" "$id" "${action_values[$action_index]}"); then
                custody=managed; evidence="validated installation receipt for $receipt_target"
                record_inspection_mechanism receipt "$receipt_target" "${action_values[$action_index]}"
            elif [[ "$presence" == present && "$custody" == managed ]]; then
                record_inspection_mechanism "${action_kinds[$action_index]}" "${action_values[$action_index]}" "${action_options[$action_index]}"
            fi
            case "$custody" in managed) managed_count=$((managed_count + 1)) ;; provided) provided_count=$((provided_count + 1)) ;; *) unverified_count=$((unverified_count + 1)) ;; esac
            if [[ "$presence" == present ]]; then
                case "$custody" in managed) present_managed=$((present_managed + 1)) ;; provided) present_provided=$((present_provided + 1)) ;; *) present_unverified=$((present_unverified + 1)) ;; esac
            fi
            if [[ -z "$first_evidence" ]]; then
                first_evidence=$evidence
            elif [[ "$presence" == present ]]; then
                first_evidence=$evidence
            fi
        fi
        action_index=$((action_index + 1))
    done
    action_index=0
    while ((action_index < ${#removal_apps[@]})); do
        if [[ "${removal_oses[$action_index]}" == "$os" && "${removal_apps[$action_index]}" == "$id" ]]; then
            case "${removal_methods[$action_index]}" in
                apt-package|pacman-package|brew-formula|brew-cask|npm-package|cargo-package|ai-skill)
                    if result=$(inspect_action "${removal_methods[$action_index]}" "${removal_targets[$action_index]}" \
                        "${removal_options[$action_index]}"); then
                        IFS=$'\t' read -r presence custody evidence <<<"$result"
                    else presence=unknown; custody=unverified; evidence="cleanup inspection failed"; fi
                    case "$presence" in present) present_count=$((present_count + 1)) ;; partial) partial_count=$((partial_count + 1)) ;; absent) absent_count=$((absent_count + 1)) ;; *) unknown_count=$((unknown_count + 1)) ;; esac
                    if [[ "$custody" == managed ]]; then
                        managed_count=$((managed_count + 1))
                        [[ "$presence" != present ]] || present_managed=$((present_managed + 1))
                        record_inspection_mechanism "${removal_methods[$action_index]}" "${removal_targets[$action_index]}" "${removal_options[$action_index]}"
                    fi
                    if [[ -z "$first_evidence" || "$presence" == present ]]; then first_evidence=$evidence; fi ;;
            esac
        fi
        action_index=$((action_index + 1))
    done
    if ((present_count > 0)); then app_presence=present
    elif ((partial_count > 0)); then app_presence=partial
    elif ((unknown_count > 0)); then app_presence=unknown
    else app_presence=absent; fi
    if ((present_managed > 0 && (present_unverified > 0 || present_provided > 0))); then app_custody=mixed
    elif ((present_managed > 0)); then app_custody=managed
    elif ((present_provided > 0 && present_unverified == 0)); then app_custody=provided
    else app_custody=unverified; fi
    if [[ "${app_states[$app_index]}" == required ]]; then policy=required; else policy=optional; fi
    for mechanism_index in "${!mechanism_kinds[@]}"; do
        case "${mechanism_kinds[$mechanism_index]}" in
            apt-package|pacman-package|brew-formula|brew-cask|npm-package|cargo-package|ai-skill) exact_method=1 ;;
            receipt)
                for recipe_index in "${!removal_apps[@]}"; do
                    if [[ "${removal_oses[$recipe_index]}" == "$os" && "${removal_apps[$recipe_index]}" == "$id" ]]; then
                        case "${removal_methods[$recipe_index]}" in path|payload-tree) exact_method=1 ;; esac
                    fi
                done ;;
        esac
    done
    if [[ "$policy" == optional && "$app_presence" == present && "$app_custody" == managed && "$exact_method" == 1 ]]; then exact_capability=enabled; fi
    if [[ "$policy" == optional && ( "$app_presence" == present || "$app_presence" == partial ) ]] && app_has_force_recipe "$os" "$id"; then
        force_capability=enabled
    fi
    formatted_label=$(versioned_application_label "${app_labels[$app_index]}" "$app_installed" "$app_latest" "$app_update")
    printf 'observation\t%s\tavailable\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$app_presence" \
        "$app_custody" "$policy" "$exact_capability" "$force_capability" "${app_groups[$app_index]}" \
        "$formatted_label" "${first_evidence:-no payload action}"
    for action_index in "${!mechanism_kinds[@]}"; do
        printf 'mechanism\t%s\t%s\t%s\t%s\n' "$id" "${mechanism_kinds[$action_index]}" \
            "${mechanism_targets[$action_index]}" "${mechanism_options[$action_index]}"
    done
}

inspect_app_by_id() {
    local os=$1 id=$2 catalog_index
    catalog_index=$(find_value_index "$id" "${app_ids[@]}") || return 1
    inspect_app "$os" "$catalog_index"
}

inspect_plan() {
    local os='' output='' index=0
    shift
    while (($#)); do
        case "$1" in
            --os) (($# >= 2)) || fail "--os requires a value"; os=$2; shift 2 ;;
            --output) (($# >= 2)) || fail "--output requires a path"; output=$2; shift 2 ;;
            *) fail "unknown inspect argument: $1" ;;
        esac
    done
    case "$os" in macos|ubuntu|debian|arch) ;; *) fail "invalid operating system: $os" ;; esac
    [[ -n "$output" ]] || fail "inspect requires --output"
    load_catalog "$os"
    mkdir -p "$(dirname "$output")"
    write_observation_snapshot "$os" "$output"
}

load_observations() {
    local path=$1 type first second third fourth fifth sixth seventh _eighth _ninth _tenth extra format_seen=0
    observation_ids=(); observation_presence=(); observation_custody=(); observation_exact=(); observation_force=()
    mechanism_apps=(); mechanism_kinds=(); mechanism_targets=(); mechanism_options=()
    [[ -r "$path" ]] || fail "cannot read observations: $path"
    while IFS=$'\t' read -r type first second third fourth fifth sixth seventh _eighth _ninth _tenth extra; do
        case "$type" in
            format) [[ "$first" == 1 && "$format_seen" == 0 ]] || fail "unsupported observation format"; format_seen=1 ;;
            os) [[ "$first" == "$prepared_os" ]] || fail "observation platform differs from prepared run" ;;
            mechanism)
                mechanism_apps+=("$first"); mechanism_kinds+=("$second"); mechanism_targets+=("$third"); mechanism_options+=("$fourth") ;;
            observation)
                find_value_index "$first" "${observation_ids[@]}" >/dev/null 2>&1 && fail "duplicate observation: $first"
                case "$third" in absent|partial|present|unknown) ;; *) fail "invalid presence for $first" ;; esac
                case "$fourth" in managed|provided|unverified|mixed) ;; *) fail "invalid custody for $first" ;; esac
                case "$sixth" in enabled|disabled) ;; *) fail "invalid exact capability for $first" ;; esac
                case "$seventh" in enabled|disabled) ;; *) fail "invalid force capability for $first" ;; esac
                observation_ids+=("$first"); observation_presence+=("$third"); observation_custody+=("$fourth")
                observation_exact+=("$sixth"); observation_force+=("$seventh") ;;
            '') ;;
            *) fail "unknown observation record: $type" ;;
        esac
    done <"$path"
    [[ "$format_seen" == 1 ]] || fail "observation format is missing"
}

parse_outcome_selection() {
    local path=$1 type id value extra format_seen=0 index
    [[ -r "$path" ]] || fail "cannot read outcome selection: $path"
    while IFS=$'\t' read -r type id value extra; do
        case "$type" in
            format) [[ "$id" == 1 && "$format_seen" == 0 ]] || fail "unsupported outcome selection format"; format_seen=1 ;;
            step)
                index=$(find_value_index "$id" "${step_ids[@]}") || fail "unknown selected step: $id"
                [[ "$value" == on || "$value" == off ]] || fail "invalid selected step state for $id"
                step_selection[$index]=$value ;;
            outcome)
                [[ -z "${extra:-}" ]] || fail "malformed outcome selection for $id"
                index=$(find_value_index "$id" "${app_ids[@]}") || fail "unknown outcome application: $id"
                case "$value" in ensure|leave|remove|force) ;; *) fail "invalid desired outcome for $id: $value" ;; esac
                [[ "${app_states[$index]}" != required || "$value" == ensure ]] || fail "required application $id must be ensured"
                app_outcomes[$index]=$value ;;
            '') ;;
            *) fail "unknown outcome selection record: $type" ;;
        esac
    done <"$path"
    [[ "$format_seen" == 1 ]] || fail "outcome selection format is missing"
}

observation_index_for_app() {
    find_value_index "$1" "${observation_ids[@]}"
}

prepare_outcome_dependencies() {
    local changed=1 app_index prerequisite prerequisite_index dependent_index observation_index old_ifs
    blocker_apps=(); blocker_kinds=(); blocker_details=()
    while [[ "$changed" == 1 ]]; do
        changed=0
        for app_index in "${!app_ids[@]}"; do
            [[ "${app_outcomes[$app_index]}" == ensure ]] || continue
            old_ifs=$IFS; IFS=','
            for prerequisite in ${app_prerequisites[$app_index]}; do
                [[ -n "$prerequisite" ]] || continue
                prerequisite_index=$(find_value_index "$prerequisite" "${app_ids[@]}") || continue
                if [[ "${app_outcomes[$prerequisite_index]}" != ensure ]]; then
                    app_outcomes[$prerequisite_index]=ensure; changed=1
                fi
            done
            IFS=$old_ifs
        done
    done
    for app_index in "${!app_ids[@]}"; do
        [[ "${app_outcomes[$app_index]}" == remove || "${app_outcomes[$app_index]}" == force ]] || continue
        for dependent_index in "${!app_ids[@]}"; do
            case ",${app_prerequisites[$dependent_index]}," in *",${app_ids[$app_index]},"*) ;; *) continue ;; esac
            case "${app_outcomes[$dependent_index]}" in remove|force) continue ;; esac
            observation_index=$(observation_index_for_app "${app_ids[$dependent_index]}") || continue
            case "${observation_presence[$observation_index]}" in present|partial|unknown)
                app_outcomes[$app_index]=leave
                blocker_apps+=("${app_ids[$app_index]}"); blocker_kinds+=(retained-dependent)
                blocker_details+=("${app_ids[$dependent_index]}")
                break ;;
            esac
        done
    done
}

write_outcome_plan() {
    local output=$1 os=$2 index=0 app_index observation_index prerequisite old_ifs
    mkdir -p "$(dirname "$output")"; : >"$output"
    printf 'format\t2\n' >>"$output"; printf 'os\t%s\n' "$os" >>"$output"
    while ((index < ${#step_ids[@]})); do
        printf 'step\t%s\t%s\t%s\t%s\n' "${step_ids[$index]}" "${step_selection[$index]}" \
            "${step_orders[$index]}" "${step_labels[$index]}" >>"$output"
        index=$((index + 1))
    done
    for app_index in "${!app_ids[@]}"; do
        app_is_available "${app_ids[$app_index]}" || continue
        observation_index=$(observation_index_for_app "${app_ids[$app_index]}") || fail "missing observation for ${app_ids[$app_index]}"
        if [[ "${app_outcomes[$app_index]}" == remove && "${observation_presence[$observation_index]}" != absent &&
              "${observation_exact[$observation_index]}" != enabled && "${observation_force[$observation_index]}" != enabled ]]; then
            fail "removal is disabled for ${app_ids[$app_index]}"
        fi
        if [[ "${app_outcomes[$app_index]}" == force && "${observation_force[$observation_index]}" != enabled ]]; then
            fail "cleanup fallback is disabled for ${app_ids[$app_index]}"
        fi
        if [[ "${app_states[$app_index]}" == required ]]; then policy=required; else policy=optional; fi
        printf 'app\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${app_ids[$app_index]}" "${app_outcomes[$app_index]}" \
            "$policy" "${app_groups[$app_index]}" "${app_labels[$app_index]}" \
            "${observation_presence[$observation_index]}" "${observation_custody[$observation_index]}" >>"$output"
        old_ifs=$IFS; IFS=','
        for prerequisite in ${app_prerequisites[$app_index]}; do
            [[ -z "$prerequisite" ]] || printf 'dependency\t%s\t%s\n' "${app_ids[$app_index]}" "$prerequisite" >>"$output"
        done
        IFS=$old_ifs
    done
    for index in "${!blocker_apps[@]}"; do
        printf 'blocker\t%s\t%s\t%s\n' "${blocker_apps[$index]}" "${blocker_kinds[$index]}" "${blocker_details[$index]}" >>"$output"
    done
    for index in "${!action_apps[@]}"; do
        app_index=$(find_value_index "${action_apps[$index]}" "${app_ids[@]}")
        case "${app_outcomes[$app_index]}" in
            ensure) printf 'action\t%s\t%s\t%s\t%s\n' "${action_apps[$index]}" "${action_kinds[$index]}" \
                "${action_values[$index]}" "${action_options[$index]}" >>"$output" ;;
            remove) ;;
        esac
    done
    for index in "${!mechanism_apps[@]}"; do
        app_index=$(find_value_index "${mechanism_apps[$index]}" "${app_ids[@]}")
        [[ "${app_outcomes[$app_index]}" == remove ]] || continue
        observation_index=$(observation_index_for_app "${app_ids[$app_index]}") || fail "missing observation for ${app_ids[$app_index]}"
        [[ "${observation_presence[$observation_index]}" != absent && "${observation_exact[$observation_index]}" == enabled ]] || continue
        case "${mechanism_kinds[$index]}" in
            apt-package|pacman-package|brew-formula|brew-cask|npm-package|cargo-package|ai-skill)
                printf 'removal\t%s\texact\t%s\t%s\t%s\n' "${mechanism_apps[$index]}" "${mechanism_kinds[$index]}" \
                    "${mechanism_targets[$index]}" "${mechanism_options[$index]}" >>"$output" ;;
            receipt)
                for removal_index in "${!removal_apps[@]}"; do
                    [[ "${removal_oses[$removal_index]}" == "$os" && "${removal_apps[$removal_index]}" == "${mechanism_apps[$index]}" ]] || continue
                    case "${removal_methods[$removal_index]}" in path|payload-tree)
                        printf 'removal\t%s\texact\t%s\t%s\t%s\n' "${mechanism_apps[$index]}" "${removal_methods[$removal_index]}" \
                            "${removal_targets[$removal_index]}" "${removal_options[$removal_index]}" >>"$output" ;;
                    esac
                done ;;
        esac
    done
    for index in "${!removal_apps[@]}"; do
        [[ "${removal_oses[$index]}" == "$os" ]] || continue
        app_index=$(find_value_index "${removal_apps[$index]}" "${app_ids[@]}")
        observation_index=$(observation_index_for_app "${app_ids[$app_index]}") || fail "missing observation for ${app_ids[$app_index]}"
        [[ "${observation_presence[$observation_index]}" != absent ]] || continue
        if [[ "${app_outcomes[$app_index]}" == force ||
              ( "${app_outcomes[$app_index]}" == remove && "${observation_exact[$observation_index]}" != enabled ) ]]; then
            printf 'removal\t%s\tforce\t%s\t%s\t%s\n' "${removal_apps[$index]}" "${removal_methods[$index]}" \
                "${removal_targets[$index]}" "${removal_options[$index]}" >>"$output"
        fi
    done
    index=0
    while ((index < ${#step_ids[@]})); do
        if [[ "${step_selection[$index]}" == on && "${step_adapters[$index]}" != dependencies ]]; then
            printf 'step-action\t%s\t%s\t%s\t\n' "${step_ids[$index]}" "${step_adapters[$index]}" "${step_arguments[$index]}" >>"$output"
        fi
        index=$((index + 1))
    done
}

prepare_plan() {
    local mode='' os='' output='' record='' selection='' observations='' approval=''
    shift
    while (($#)); do
        case "$1" in
            --mode) (($# >= 2)) || fail "--mode requires a value"; mode=$2; shift 2 ;;
            --os) (($# >= 2)) || fail "--os requires a value"; os=$2; shift 2 ;;
            --output) (($# >= 2)) || fail "--output requires a path"; output=$2; shift 2 ;;
            --record) (($# >= 2)) || fail "--record requires a path"; record=$2; shift 2 ;;
            --selection) (($# >= 2)) || fail "--selection requires a path"; selection=$2; shift 2 ;;
            --observations) (($# >= 2)) || fail "--observations requires a path"; observations=$2; shift 2 ;;
            --approval) (($# >= 2)) || fail "--approval requires a path"; approval=$2; shift 2 ;;
            *) fail "unknown prepare argument: $1" ;;
        esac
    done
    case "$mode" in visual|defaults|full|record|outcomes) ;; *) fail "invalid prepare mode: $mode" ;; esac
    case "$os" in macos|ubuntu|debian|arch) ;; *) fail "invalid operating system: $os" ;; esac
    [[ -n "$output" ]] || fail "prepare requires --output"
    [[ "$mode" != record || -n "$record" ]] || fail "record mode requires --record"
    [[ "$mode" != outcomes || ( -n "$selection" && -n "$observations" ) ]] ||
        fail "outcomes mode requires --selection and --observations"
    [[ "$mode" != visual || -n "$approval" ]] || fail "visual mode requires --approval"

    load_catalog "$os"
    if [[ "$mode" == outcomes ]]; then
        initialize_selection defaults
        resolve_app_selection
        app_outcomes=()
        for index in "${!app_ids[@]}"; do
            if [[ "${app_selection[$index]}" == on ]]; then app_outcomes+=(ensure); else app_outcomes+=(leave); fi
        done
        prepared_os=$os
        load_observations "$observations"
        parse_outcome_selection "$selection"
        prepare_outcome_dependencies
        write_outcome_plan "$output" "$os"
        render_review "$output"
        return 0
    fi
    initialize_selection "$mode"
    case "$mode" in
        record) parse_record "$record" true ;;
        defaults|visual)
            if [[ -e "$default_record" ]] && ! parse_record "$default_record" false; then
                warn "default plan record is invalid; using repository defaults"
                initialize_selection defaults
            fi
            ;;
    esac
    if [[ "$mode" == visual ]]; then
        visual_tty=${DOTFILES_INSTALL_PLAN_TTY:-/dev/tty}
        if [[ -z "${DOTFILES_INSTALL_TUI:-}" && ( ! -r "$visual_tty" || ! -w "$visual_tty" ) ]]; then
            fail "visual selection requires a terminal; use --unattended"
        fi
        resolve_app_selection
        app_outcomes=()
        for index in "${!app_ids[@]}"; do
            if [[ "${app_selection[$index]}" == on ]]; then app_outcomes+=(ensure); else app_outcomes+=(leave); fi
        done
        prepare_visual_outcome_run "$os" "$output" "$approval" "$observations"
        return $?
    fi
    resolve_app_selection
    write_resolved_plan "$os" "$output"
    render_review "$output"
}

load_resolved_plan() {
    local path=$1 type first second third fourth fifth sixth seventh eighth extra outcome presence format_seen=0
    apply_step_ids=(); apply_step_states=(); apply_step_labels=(); apply_step_statuses=()
    apply_app_ids=(); apply_app_states=(); apply_app_outcomes=(); apply_app_labels=(); apply_app_presences=(); apply_app_statuses=()
    apply_dependency_apps=(); apply_dependency_requirements=()
    apply_action_apps=(); apply_action_kinds=(); apply_action_values=(); apply_action_options=(); apply_action_done=()
    apply_step_action_ids=(); apply_step_action_kinds=(); apply_step_action_values=(); apply_step_action_options=()
    apply_removal_apps=(); apply_removal_modes=(); apply_removal_kinds=(); apply_removal_targets=(); apply_removal_options=()
    [[ -r "$path" ]] || fail "cannot read resolved plan: $path"
    while IFS=$'\t' read -r type first second third fourth fifth sixth seventh eighth extra; do
        case "$type" in
            format)
                [[ ( "$first" == 1 || "$first" == 2 ) && "$format_seen" == 0 && -z "$second$third$fourth$fifth$sixth$seventh$eighth${extra:-}" ]] || fail "unsupported resolved plan format"
                apply_format=$first; format_seen=1 ;;
            os)
                [[ -z "$second$third$fourth$fifth$sixth$seventh$eighth${extra:-}" ]] || fail "malformed resolved plan OS"
                case "$first" in macos|ubuntu|debian|arch) apply_os=$first ;; *) fail "invalid resolved plan OS" ;; esac ;;
            step)
                [[ -z "$fifth$sixth$seventh$eighth${extra:-}" ]] || fail "malformed resolved step"
                [[ "$second" == on || "$second" == off ]] || fail "invalid resolved step state"
                apply_step_ids+=("$first"); apply_step_states+=("$second"); apply_step_labels+=("$fourth")
                if [[ "$second" == on ]]; then apply_step_statuses+=(pending); else apply_step_statuses+=(skipped); fi ;;
            group) ;;
            app)
                if [[ "${apply_format:-1}" == 1 ]]; then
                    [[ -z "$sixth$seventh$eighth${extra:-}" ]] || fail "malformed resolved application"
                    [[ "$second" == on || "$second" == off ]] || fail "invalid resolved application state"
                    if [[ "$second" == on ]]; then outcome=ensure; else outcome=leave; fi
                    presence=unknown
                else
                    [[ -n "$sixth$seventh" && -z "$eighth${extra:-}" ]] || fail "malformed prepared application"
                    case "$second" in ensure|leave|remove|force) outcome=$second ;; *) fail "invalid desired outcome" ;; esac
                    presence=$sixth
                fi
                apply_app_ids+=("$first"); apply_app_outcomes+=("$outcome"); apply_app_labels+=("$fifth"); apply_app_presences+=("$presence")
                if [[ "$outcome" == ensure ]]; then apply_app_states+=(on); else apply_app_states+=(off); fi
                if [[ "$outcome" == leave ]]; then apply_app_statuses+=(skipped); else apply_app_statuses+=(pending); fi ;;
            dependency)
                [[ -z "$third$fourth$fifth$sixth$seventh$eighth${extra:-}" ]] || fail "malformed dependency"
                apply_dependency_apps+=("$first"); apply_dependency_requirements+=("$second") ;;
            removal)
                [[ -z "$sixth$seventh$eighth${extra:-}" ]] || fail "malformed prepared removal"
                case "$second" in exact|force) ;; *) fail "invalid removal mode" ;; esac
                apply_removal_apps+=("$first"); apply_removal_modes+=("$second"); apply_removal_kinds+=("$third")
                apply_removal_targets+=("$fourth"); apply_removal_options+=("$fifth") ;;
            blocker) [[ -z "$fourth$fifth$sixth$seventh$eighth${extra:-}" ]] || fail "malformed blocker" ;;
            action)
                [[ -z "$fifth$sixth$seventh$eighth${extra:-}" ]] || fail "malformed resolved action"
                apply_action_apps+=("$first"); apply_action_kinds+=("$second")
                apply_action_values+=("$third"); apply_action_options+=("$fourth"); apply_action_done+=(0) ;;
            step-action)
                [[ -z "$fifth$sixth$seventh$eighth${extra:-}" ]] || fail "malformed step action"
                apply_step_action_ids+=("$first"); apply_step_action_kinds+=("$second")
                apply_step_action_values+=("$third"); apply_step_action_options+=("$fourth") ;;
            '') ;;
            *) fail "unknown resolved plan record: $type" ;;
        esac
    done <"$path"
    [[ "$format_seen" == 1 && -n "${apply_os:-}" ]] || fail "incomplete resolved plan"
}

run_brew_action() {
    local kind=$1 value=$2 option=$3 declaration work_file
    command -v brew >/dev/null 2>&1 || {
        # shellcheck source=download.sh
        source "$root_dir/lib/download.sh"
        # shellcheck source=../setup-brew.sh
        source "$root_dir/setup-brew.sh"
        setup_homebrew
    }
    case "$kind" in
        brew-tap) brew tap "$value" ;;
        brew-formula|brew-cask)
            work_file=$(mktemp "${TMPDIR:-/tmp}/dotfiles-selected.XXXXXX.Brewfile")
            if [[ "$kind" == brew-cask ]]; then
                declaration="cask \"$value\""
            elif [[ "$option" == trusted=true ]]; then
                declaration="brew \"$value\", trusted: true"
            else
                declaration="brew \"$value\""
            fi
            printf '%s\n' "$declaration" >"$work_file"
            # shellcheck source=homebrew.sh
            source "$root_dir/lib/homebrew.sh"
            homebrew_bundle_install_resilient "$work_file"
            local brew_result=$?
            rm -f "$work_file"
            return "$brew_result"
            ;;
    esac
}

ensure_catalog_command_alias() {
    local value=$1 command_name=${1%%:*} packaged_name=${1#*:} packaged_path target
    [[ "$command_name" != "$packaged_name" ]] || return 1
    command -v "$command_name" >/dev/null 2>&1 && return 0
    packaged_path=$(command -v "$packaged_name" 2>/dev/null) || return 0
    target="$HOME/.local/bin/$command_name"
    mkdir -p "${target%/*}"
    if [[ -L "$target" ]]; then
        [[ $(readlink "$target") == "$packaged_path" ]] && return 0
        rm -f "$target"
    elif [[ -e "$target" ]]; then
        echo "Cannot manage command alias over existing file: $target" >&2
        return 1
    fi
    ln -s "$packaged_path" "$target"
}

cargo_package_binary() {
    case "$1" in
        tealdeer) echo tldr ;;
        bottom) echo btm ;;
        du-dust) echo dust ;;
        ripgrep) echo rg ;;
        tree-sitter-cli) echo tree-sitter ;;
        cargo-edit) echo cargo-add ;;
        wasm-bindgen-cli) echo wasm-bindgen ;;
        watchexec-cli) echo watchexec ;;
        *) echo "$1" ;;
    esac
}

run_real_adapter() {
    local operation=$1 kind=$2 value=$3 option=$4 function_name binary result presence preview preview_target alias_target privilege=()
    if ((EUID != 0)); then privilege=(sudo -n); fi
    if [[ "$operation" == force && ( "$kind" == retain || "$kind" == retain-effect ) ]]; then
        DOTFILES_ADAPTER_METHOD_STATUS=retained
        return 0
    fi
    if [[ "$operation" == force && "$kind" == service ]]; then
        command -v systemctl >/dev/null 2>&1 || return 0
        "${privilege[@]}" systemctl disable --now "$value.service" "$value.socket" 2>/dev/null || true
        return 0
    fi
    if [[ "$operation" == force && "$kind" == alias ]]; then
        case "$value" in \~/*) value="$HOME/${value#\~/}" ;; esac
        if [[ -L "$value" ]]; then
            alias_target=$(readlink "$value")
            if [[ "${alias_target##*/}" == "$option" ]]; then rm -f -- "$value"
            else DOTFILES_ADAPTER_METHOD_STATUS=retained; echo "Retaining changed command alias: $value" >&2; fi
        elif [[ -e "$value" ]]; then
            DOTFILES_ADAPTER_METHOD_STATUS=retained; echo "Retaining non-symlink command alias: $value" >&2
        fi
        return 0
    fi
    if [[ "$operation" == force && "$kind" == managed-file ]]; then
        case "$value" in \~/*) value="$HOME/${value#\~/}" ;; esac
        if [[ -e "$value" ]]; then
            [[ ! -L "$value" && -f "$value" ]] || { DOTFILES_ADAPTER_METHOD_STATUS=retained; echo "Retaining unexpected managed file: $value" >&2; return 0; }
            [[ "$(cat "$value")" == "$option" ]] || { DOTFILES_ADAPTER_METHOD_STATUS=retained; echo "Retaining changed managed file: $value" >&2; return 0; }
            if [[ "$value" == "$HOME"/* ]]; then rm -f -- "$value"; else "${privilege[@]}" rm -f -- "$value"; fi
        fi
        return 0
    fi
    if [[ ( "$operation" == force || "$operation" == remove ) && ( "$kind" == path || "$kind" == payload-tree ) ]]; then
        case "$value" in \~/*) value="$HOME/${value#\~/}" ;; esac
        case "$value" in "$HOME"/*|/usr/local/bin/*) ;; *) echo "Refusing unsafe cleanup target: $value" >&2; return 1 ;; esac
        if [[ "$kind" == path ]]; then
            [[ ! -d "$value" ]] || { echo "Refusing directory cleanup target: $value" >&2; return 1; }
            if [[ "$value" == "$HOME"/* ]]; then rm -f -- "$value"; else "${privilege[@]}" rm -f -- "$value"; fi
        else
            [[ "$value" != "$HOME" && "$value" != /usr/local/bin ]] || { echo "Refusing broad payload tree: $value" >&2; return 1; }
            rm -rf -- "$value"
        fi
        return 0
    fi
    if [[ "$operation" == remove || "$operation" == force ]]; then
        if [[ "$kind" == apt-package ]]; then
            preview=$(apt-get -s remove -- "$value") || return 1
            while IFS= read -r preview_target; do
                preview_target=${preview_target%%:*}
                case "${DOTFILES_ALLOWED_REMOVALS:-}|$value|" in *"|$preview_target|"*) ;;
                    *) echo "Removal preview includes unexpected package: $preview_target" >&2; return 1 ;;
                esac
            done < <(printf '%s\n' "$preview" | awk '/^Remv / {print $2}')
        fi
        if [[ "$operation" == force ]]; then
            result=$(inspect_real_action "$kind" "$value" "$option") || result=$'unknown\tunverified\tinspection failed'
            IFS=$'\t' read -r presence _ <<<"$result"
            [[ "$presence" != absent ]] || return 0
        fi
        case "$kind" in
            apt-package) "${privilege[@]}" apt-get remove -y -- "$value"; return ;;
            pacman-package) "${privilege[@]}" pacman -R --noconfirm "$value"; return ;;
            brew-formula) brew uninstall --formula "$value"; return ;;
            brew-cask) brew uninstall --cask "$value"; return ;;
            npm-package) npm uninstall --global "$value" </dev/null; return ;;
            cargo-package) cargo uninstall "$value" </dev/null; return ;;
            ai-skill)
                command -v npx >/dev/null 2>&1 || { echo "AI skills removal requires npx; install Node first." >&2; return 1; }
                ensure_installers_loaded
                remove_ai_skill_global "$option"; return ;;
            *) echo "Unsupported exact removal adapter: $kind" >&2; return 1 ;;
        esac
    fi
    case "$kind" in
        provided) return 0 ;;
        command-alias) ensure_catalog_command_alias "$value" ;;
        apt-package|pacman-package)
            # shellcheck source=packages.sh
            source "$root_dir/lib/packages.sh"
            linux_packages_install "$value"
            ;;
        brew-formula|brew-cask|brew-tap) run_brew_action "$kind" "$value" "$option" ;;
        npm-package)
            if [[ "$option" == ignore-scripts ]]; then
                npm install --global --ignore-scripts "$value" </dev/null
            else
                npm install --global "$value" </dev/null
            fi
            ;;
        cargo-package)
            binary=$(cargo_package_binary "$value")
            [[ "$option" != missing-only ]] || ! command -v "$binary" >/dev/null 2>&1 || return 0
            cargo install --locked "$value" </dev/null
            ;;
        ai-skill)
            command -v npx >/dev/null 2>&1 || { echo "AI skills installation requires npx; install Node first." >&2; return 1; }
            ensure_installers_loaded
            install_ai_skill_batch "$value" "$option"
            ;;
        installer)
            ensure_installers_loaded
            if [[ $(type -t "install_$value") == function ]]; then function_name="install_$value"
            elif [[ $(type -t "setup_$value") == function ]]; then function_name="setup_$value"
            else echo "Unknown installer adapter: $value" >&2; return 1
            fi
            "$function_name"
            ;;
        command) (cd "$root_dir" && "$value") ;;
        *) echo "Unsupported execution adapter: $kind" >&2; return 1 ;;
    esac
}

run_plan_adapter() {
    local operation=$1 kind=$2 value=$3 option=$4
    if [[ -n "${DOTFILES_INSTALL_PLAN_ADAPTER:-}" ]]; then
        "$DOTFILES_INSTALL_PLAN_ADAPTER" "$operation" "$kind" "$value" "$option"
    else
        run_real_adapter "$operation" "$kind" "$value" "$option"
    fi
}

run_real_batch() {
    local operation=$1 kind=$2 entries=$3 _app value option brewfile result=0 source='' inventory='' inventory_ready=0
    local cargo_inventory='' installed_version latest_version
    local -a values=() normal=() scriptless=() source_skills=()
    case "$kind" in
        apt-package|pacman-package)
            while IFS=$'\t' read -r _app value option; do values+=("$value"); done <"$entries"
            source "$root_dir/lib/packages.sh"
            linux_packages_optimize_mirrors || echo 'Warning: mirror optimization failed; continuing.' >&2
            linux_packages_refresh
            linux_packages_install "${values[@]}"
            ;;
        brew-formula|brew-cask|brew-tap)
            command -v brew >/dev/null 2>&1 || {
                source "$root_dir/lib/download.sh"
                source "$root_dir/setup-brew.sh"
                setup_homebrew
            }
            if [[ "${_INSTALL_PLAN_BREW_PREPARED:-0}" != 1 ]]; then
                brew update || echo 'Warning: Homebrew update failed; continuing.' >&2
                _INSTALL_PLAN_BREW_PREPARED=1
            fi
            brewfile=$(mktemp "${TMPDIR:-/tmp}/dotfiles-selected.XXXXXX.Brewfile")
            while IFS=$'\t' read -r _app value option; do
                case "$kind" in
                    brew-tap) printf 'tap "%s"\n' "$value" ;;
                    brew-cask) printf 'cask "%s"\n' "$value" ;;
                    brew-formula)
                        if [[ "$option" == trusted=true ]]; then printf 'brew "%s", trusted: true\n' "$value"
                        else printf 'brew "%s"\n' "$value"; fi ;;
                esac
            done <"$entries" >"$brewfile"
            source "$root_dir/lib/homebrew.sh"
            homebrew_bundle_install_resilient "$brewfile" || result=$?
            rm -f "$brewfile"
            return "$result"
            ;;
        npm-package)
            while IFS=$'\t' read -r _app value option; do
                if [[ "$operation" == reconcile ]] &&
                    npm list --global --depth=0 "$value" >/dev/null 2>&1; then
                    continue
                fi
                if [[ "$option" == ignore-scripts ]]; then scriptless+=("$value"); else normal+=("$value"); fi
            done <"$entries"
            ((${#normal[@]} == 0)) || npm install --global "${normal[@]}" </dev/null || result=1
            ((${#scriptless[@]} == 0)) || npm install --global --ignore-scripts "${scriptless[@]}" </dev/null || result=1
            return "$result"
            ;;
        cargo-package)
            if [[ "$operation" == reconcile ]]; then
                cargo_inventory=$(cargo install --list 2>/dev/null || true)
            fi
            while IFS=$'\t' read -r _app value option; do
                if [[ "$option" == missing-only ]] && command -v "$(cargo_package_binary "$value")" >/dev/null 2>&1; then
                    continue
                fi
                if [[ "$operation" == reconcile && "$option" != missing-only && -n "$cargo_inventory" ]]; then
                    installed_version=$(printf '%s\n' "$cargo_inventory" | awk -v package="$value" \
                        '$1 == package && $2 ~ /^v/ { version=$2; sub(/^v/, "", version); sub(/:$/, "", version); print version; exit }')
                    latest_version=$(cargo info "$value" 2>/dev/null | awk '$1 == "version:" { print $2; exit }')
                    if [[ -n "$installed_version" && "$installed_version" == "$latest_version" ]]; then
                        continue
                    fi
                fi
                values+=("$value")
            done <"$entries"
            ((${#values[@]} == 0)) || cargo install --locked "${values[@]}" </dev/null
            ;;
        ai-skill)
            command -v npx >/dev/null 2>&1 || {
                echo "AI skills installation requires npx; install Node first." >&2
                return 1
            }
            if [[ "$operation" == reconcile ]]; then
                inventory=$(mktemp "${TMPDIR:-/tmp}/dotfiles-ai-skills.XXXXXX")
                if write_ai_skill_inventory "$inventory"; then inventory_ready=1; fi
            fi
            while IFS=$'\t' read -r _app value option; do
                if [[ -z "$source" ]]; then
                    source=$value
                elif [[ "$source" != "$value" ]]; then
                    echo "AI skill batch contains more than one source" >&2
                    [[ -z "$inventory" ]] || rm -f "$inventory"
                    return 1
                fi
                if [[ "$inventory_ready" != 1 ]] || ! ai_skill_inventory_has "$source" "$option" "$inventory"; then
                    source_skills+=("$option")
                fi
            done <"$entries"
            if ((${#source_skills[@]})); then
                ensure_installers_loaded
                install_ai_skill_batch "$source" "${source_skills[@]}" || result=1
            fi
            [[ -z "$inventory" ]] || rm -f "$inventory"
            return "$result"
            ;;
    esac
}

execute_batch_prerequisites() {
    local operation=$1 batch_kind=$2 action_index=0 dependency_index prerequisite result=0
    while ((action_index < ${#apply_action_apps[@]})); do
        if [[ "${apply_action_kinds[$action_index]}" == "$batch_kind" ]]; then
            dependency_index=0
            while ((dependency_index < ${#apply_dependency_apps[@]})); do
                if [[ "${apply_dependency_apps[$dependency_index]}" == "${apply_action_apps[$action_index]}" ]]; then
                    prerequisite=${apply_dependency_requirements[$dependency_index]}
                    execute_plan_app "$prerequisite" "$operation" || result=1
                fi
                dependency_index=$((dependency_index + 1))
            done
        fi
        action_index=$((action_index + 1))
    done
    return "$result"
}

execute_ai_skill_source_batches() {
    local operation=$1 source action_index scan_index entries batch_result app_index
    local -a handled_sources=()
    action_index=0
    while ((action_index < ${#apply_action_apps[@]})); do
        [[ "${interrupted:-0}" != 1 ]] || break
        if [[ "${apply_action_kinds[$action_index]}" != ai-skill ]]; then
            action_index=$((action_index + 1))
            continue
        fi
        source=${apply_action_values[$action_index]}
        if find_value_index "$source" "${handled_sources[@]}" >/dev/null 2>&1; then
            action_index=$((action_index + 1))
            continue
        fi
        handled_sources+=("$source")
        entries=$(mktemp "${TMPDIR:-/tmp}/dotfiles-action-batch.XXXXXX")
        scan_index=0
        while ((scan_index < ${#apply_action_apps[@]})); do
            if [[ "${apply_action_kinds[$scan_index]}" == ai-skill &&
                  "${apply_action_values[$scan_index]}" == "$source" ]]; then
                printf '%s\t%s\t%s\n' "${apply_action_apps[$scan_index]}" \
                    "${apply_action_values[$scan_index]}" "${apply_action_options[$scan_index]}" >>"$entries"
                start_action_operation "$scan_index"
            fi
            scan_index=$((scan_index + 1))
        done
        batch_result=0
        if [[ -n "${DOTFILES_INSTALL_PLAN_BATCH_ADAPTER:-}" ]]; then
            "$DOTFILES_INSTALL_PLAN_BATCH_ADAPTER" "$operation" ai-skill "$entries" || batch_result=$?
        else
            run_real_batch "$operation" ai-skill "$entries" || batch_result=$?
        fi
        rm -f "$entries"
        scan_index=0
        while ((scan_index < ${#apply_action_apps[@]})); do
            if [[ "${apply_action_kinds[$scan_index]}" == ai-skill &&
                  "${apply_action_values[$scan_index]}" == "$source" ]]; then
                apply_action_done[scan_index]=1
                if [[ "$batch_result" == 0 ]]; then
                    settle_action_operation "$scan_index" succeeded
                else
                    app_index=$(find_value_index "${apply_action_apps[$scan_index]}" "${apply_app_ids[@]}") ||
                        fail "AI skill batch action has no application: ${apply_action_apps[$scan_index]}"
                    settle_app_operation "$app_index" failed
                fi
            fi
            scan_index=$((scan_index + 1))
        done
        [[ "${interrupted:-0}" != 1 ]] || break
        action_index=$((action_index + 1))
    done
}

execute_action_batches() {
    local operation=$1 kind index entries batch_result prerequisite_batch_failed=0
    [[ -z "${DOTFILES_INSTALL_PLAN_ADAPTER:-}" || -n "${DOTFILES_INSTALL_PLAN_BATCH_ADAPTER:-}" ]] || return 0
    for kind in apt-package pacman-package brew-tap brew-formula brew-cask npm-package cargo-package ai-skill; do
        [[ "${interrupted:-0}" != 1 ]] || break
        if [[ "$prerequisite_batch_failed" == 1 &&
              ( "$kind" == npm-package || "$kind" == cargo-package || "$kind" == ai-skill ) ]]; then
            continue
        fi
        if [[ "$kind" == npm-package || "$kind" == cargo-package || "$kind" == ai-skill ]]; then
            execute_batch_prerequisites "$operation" "$kind" || continue
        fi
        if [[ "$kind" == ai-skill ]]; then
            execute_ai_skill_source_batches "$operation"
            continue
        fi
        entries=$(mktemp "${TMPDIR:-/tmp}/dotfiles-action-batch.XXXXXX")
        index=0
        while ((index < ${#apply_action_apps[@]})); do
            if [[ "${apply_action_kinds[$index]}" == "$kind" ]]; then
                printf '%s\t%s\t%s\n' "${apply_action_apps[$index]}" \
                    "${apply_action_values[$index]}" "${apply_action_options[$index]}" >>"$entries"
            fi
            index=$((index + 1))
        done
        if [[ ! -s "$entries" ]]; then rm -f "$entries"; continue; fi
        index=0
        while ((index < ${#apply_action_apps[@]})); do
            [[ "${apply_action_kinds[$index]}" != "$kind" ]] || start_action_operation "$index"
            index=$((index + 1))
        done
        batch_result=0
        if [[ -n "${DOTFILES_INSTALL_PLAN_BATCH_ADAPTER:-}" ]]; then
            "$DOTFILES_INSTALL_PLAN_BATCH_ADAPTER" "$operation" "$kind" "$entries" || batch_result=$?
        else
            run_real_batch "$operation" "$kind" "$entries" || batch_result=$?
        fi
        rm -f "$entries"
        if [[ "$batch_result" == 0 ]]; then
            index=0
            while ((index < ${#apply_action_apps[@]})); do
                if [[ "${apply_action_kinds[$index]}" == "$kind" ]]; then
                    apply_action_done[$index]=1
                    settle_action_operation "$index" succeeded
                fi
                index=$((index + 1))
            done
        elif [[ "$kind" == apt-package || "$kind" == pacman-package ||
                "$kind" == brew-tap || "$kind" == brew-formula || "$kind" == brew-cask ]]; then
            prerequisite_batch_failed=1
        fi
        [[ "${interrupted:-0}" != 1 ]] || break
    done
}

emit_event() {
    [[ "${DOTFILES_INSTALL_PLAN_EVENTS:-0}" == 1 ]] || return 0
    local record=$'event\t1' field event_fd=${DOTFILES_INSTALL_PLAN_EVENT_FD:-1}
    for field in "$@"; do record+=$'\t'"$field"; done
    case "$event_fd" in
        1) printf '%s\n' "$record" ;;
        3) printf '%s\n' "$record" >&3 ;;
        *) fail "invalid structured-event file descriptor" ;;
    esac
}

ensure_installers_loaded() {
    [[ "${_INSTALL_PLAN_INSTALLERS_LOADED:-0}" == 1 ]] && return 0
    # shellcheck source=../installers/source_installers.sh
    source "$root_dir/installers/source_installers.sh" >/dev/null
    _INSTALL_PLAN_INSTALLERS_LOADED=1
}

installer_exposes_operations() {
    local installer=$1
    [[ -z "${DOTFILES_INSTALL_PLAN_ADAPTER:-}" ]] || return 1
    ensure_installers_loaded
    [[ $(type -t "install_${installer}_operations") == function ]]
}

register_event_operation() {
    find_value_index "$1" "${event_operation_ids[@]}" >/dev/null 2>&1 && fail "duplicate progress operation: $1"
    event_operation_ids+=("$1")
    event_operation_labels+=("$2")
    event_operation_states+=(pending)
}

action_operation_label() {
    local index app_index kind value option
    index=$1; kind=${apply_action_kinds[$index]}; value=${apply_action_values[$index]}; option=${apply_action_options[$index]}
    app_index=$(find_value_index "${apply_action_apps[$index]}" "${apply_app_ids[@]}") || return 1
    case "$kind" in
        apt-package) printf 'APT package %s\n' "$value" ;;
        pacman-package) printf 'pacman package %s\n' "$value" ;;
        brew-tap) printf 'Homebrew tap %s\n' "$value" ;;
        brew-formula) printf 'Homebrew formula %s\n' "$value" ;;
        brew-cask) printf 'Homebrew cask %s\n' "$value" ;;
        npm-package) printf 'npm package %s\n' "$value" ;;
        cargo-package) printf 'Cargo package %s\n' "$value" ;;
        ai-skill) printf 'AI skill %s\n' "$option" ;;
        command-alias) printf 'Command alias for %s\n' "${apply_app_labels[$app_index]}" ;;
        provided) printf 'Provided dependency %s\n' "${apply_app_labels[$app_index]}" ;;
        installer) printf 'Install %s\n' "${apply_app_labels[$app_index]}" ;;
        *) printf '%s: %s\n' "${apply_app_labels[$app_index]}" "$value" ;;
    esac
}

register_action_operations() {
    local index=$1 sub_id sub_label registered=0
    if [[ "${apply_action_kinds[$index]}" == installer ]] &&
        installer_exposes_operations "${apply_action_values[$index]}"; then
        while IFS=$'\t' read -r sub_id sub_label; do
            [[ -n "$sub_id" && -n "$sub_label" ]] || continue
            valid_id "$sub_id" || fail "invalid installer operation id for ${apply_action_values[$index]}: $sub_id"
            register_event_operation "action:$index:$sub_id" "$sub_label"
            registered=$((registered + 1))
        done < <("install_${apply_action_values[$index]}_operations")
        ((registered > 0)) || fail "installer ${apply_action_values[$index]} declares no operations"
    else
        register_event_operation "action:$index" "$(action_operation_label "$index")"
    fi
}

removal_operation_label() {
    local index=$1
    case "${apply_removal_kinds[$index]}" in
        ai-skill) printf 'Remove AI skill %s\n' "${apply_removal_options[$index]}" ;;
        *) printf 'Remove %s\n' "${apply_removal_targets[$index]}" ;;
    esac
}

initialize_event_operations() {
    local index app_index outcome dependencies_enabled=0
    event_operation_ids=(); event_operation_labels=(); event_operation_states=()
    for index in "${!apply_step_ids[@]}"; do
        if [[ "${apply_step_ids[$index]}" == dependencies && "${apply_step_states[$index]}" == on ]]; then
            dependencies_enabled=1
            break
        fi
    done
    if [[ "$dependencies_enabled" == 1 ]]; then
        for index in "${!apply_action_apps[@]}"; do
            app_index=$(find_value_index "${apply_action_apps[$index]}" "${apply_app_ids[@]}") || continue
            [[ "${apply_app_outcomes[$app_index]}" == ensure ]] || continue
            register_action_operations "$index"
        done
        for index in "${!apply_removal_apps[@]}"; do
            app_index=$(find_value_index "${apply_removal_apps[$index]}" "${apply_app_ids[@]}") || continue
            case "${apply_app_outcomes[$app_index]}" in remove|force)
                register_event_operation "removal:$index" "$(removal_operation_label "$index")" ;;
            esac
        done
        for app_index in "${!apply_app_ids[@]}"; do
            outcome=${apply_app_outcomes[$app_index]}
            [[ "$outcome" == leave ]] || register_event_operation "verify:$app_index" "Verify ${apply_app_labels[$app_index]}"
        done
    fi
    for index in "${!apply_step_ids[@]}"; do
        [[ "${apply_step_states[$index]}" == on && "${apply_step_ids[$index]}" != dependencies ]] || continue
        register_event_operation "step:$index" "${apply_step_labels[$index]}"
    done
    event_total=${#event_operation_ids[@]}
    event_settled=0
}

start_registered_operation() {
    local id=$1 index
    index=$(find_value_index "$id" "${event_operation_ids[@]}") || fail "unregistered progress operation: $id"
    [[ "${event_operation_states[$index]}" == pending ]] || return 0
    event_operation_states[$index]=active
    emit_event operation-start "$id" "${event_operation_labels[$index]}" indeterminate
}

settle_registered_operation() {
    local id=$1 status=$2 index
    index=$(find_value_index "$id" "${event_operation_ids[@]}") || fail "unregistered progress operation: $id"
    [[ "${event_operation_states[$index]}" != settled ]] || return 0
    start_registered_operation "$id"
    event_operation_states[$index]=settled
    event_settled=$((event_settled + 1))
    emit_event operation-settled "$id" "$status" "$event_settled" "$event_total"
}

action_has_suboperations() {
    local index=$1
    [[ "${apply_action_kinds[$index]}" == installer ]] &&
        installer_exposes_operations "${apply_action_values[$index]}"
}

start_action_operation() {
    local index=$1
    action_has_suboperations "$index" || start_registered_operation "action:$index"
}

settle_action_operation() {
    local index status operation_index id prefix
    index=$1; status=$2; prefix="action:$index:"
    if action_has_suboperations "$index"; then
        for operation_index in "${!event_operation_ids[@]}"; do
            id=${event_operation_ids[$operation_index]}
            case "$id" in "$prefix"*) settle_registered_operation "$id" "$status" ;; esac
        done
    else
        settle_registered_operation "action:$index" "$status"
    fi
}

run_installer_operation() {
    local sub_id=$1 label=$2 result=0 id
    shift 2
    if [[ -z "${_INSTALL_PLAN_CURRENT_ACTION_INDEX:-}" ]]; then
        "$@"
        return
    fi
    id="action:${_INSTALL_PLAN_CURRENT_ACTION_INDEX}:$sub_id"
    start_registered_operation "$id"
    "$@" || result=$?
    if [[ "$result" == 0 ]]; then settle_registered_operation "$id" succeeded
    else settle_registered_operation "$id" failed; fi
    return "$result"
}

settle_app_operation() {
    local index=$1 status=$2 action_index removal_index
    apply_app_statuses[$index]=$status
    for action_index in "${!apply_action_apps[@]}"; do
        [[ "${apply_action_apps[$action_index]}" != "${apply_app_ids[$index]}" ]] ||
            settle_action_operation "$action_index" "$status"
    done
    for removal_index in "${!apply_removal_apps[@]}"; do
        [[ "${apply_removal_apps[$removal_index]}" != "${apply_app_ids[$index]}" ]] ||
            settle_registered_operation "removal:$removal_index" "$status"
    done
    settle_registered_operation "verify:$index" "$status"
}

settle_step_operation() {
    local index=$1 status=$2
    apply_step_statuses[$index]=$status
    [[ "${apply_step_ids[$index]}" == dependencies ]] || settle_registered_operation "step:$index" "$status"
}

execute_plan_removal() {
    local id=$1 path=${2:-} index status dependency_index dependent dependent_index removal_index had_failure=0 operation result presence custody method_status
    index=$(find_value_index "$id" "${apply_app_ids[@]}") || return 1
    status=${apply_app_statuses[$index]}
    case "$status" in succeeded) return 0 ;; failed|partial|blocked) return 1 ;; running) return 1 ;; esac
    case "$path" in *"|$id|"*) settle_app_operation "$index" failed; return 1 ;; esac
    apply_app_statuses[$index]=running
    dependency_index=0
    while ((dependency_index < ${#apply_dependency_apps[@]})); do
        if [[ "${apply_dependency_requirements[$dependency_index]}" == "$id" ]]; then
            dependent=${apply_dependency_apps[$dependency_index]}
            dependent_index=$(find_value_index "$dependent" "${apply_app_ids[@]}") || { settle_app_operation "$index" blocked; return 1; }
            case "${apply_app_outcomes[$dependent_index]}" in
                remove|force) execute_plan_removal "$dependent" "$path|$id|" || { settle_app_operation "$index" blocked; return 1; } ;;
                *) settle_app_operation "$index" blocked; return 1 ;;
            esac
        fi
        dependency_index=$((dependency_index + 1))
    done
    DOTFILES_ALLOWED_REMOVALS=''
    for removal_index in "${!apply_removal_apps[@]}"; do
        if [[ "${apply_removal_apps[$removal_index]}" == "$id" ]]; then
            DOTFILES_ALLOWED_REMOVALS+="|${apply_removal_targets[$removal_index]}|"
        fi
    done
    export DOTFILES_ALLOWED_REMOVALS
    removal_index=0
    while ((removal_index < ${#apply_removal_apps[@]})); do
        if [[ "${apply_removal_apps[$removal_index]}" == "$id" ]]; then
            if [[ "${apply_removal_modes[$removal_index]}" == exact ]]; then operation=remove; else operation=force; fi
            method_status=succeeded; DOTFILES_ADAPTER_METHOD_STATUS=succeeded
            start_registered_operation "removal:$removal_index"
            if [[ "${apply_removal_kinds[$removal_index]}" == retain || "${apply_removal_kinds[$removal_index]}" == retain-effect ]]; then
                method_status=retained
            elif ! run_plan_adapter "$operation" "${apply_removal_kinds[$removal_index]}" \
                "${apply_removal_targets[$removal_index]}" "${apply_removal_options[$removal_index]}"; then
                method_status=failed; had_failure=1
            elif [[ "${DOTFILES_ADAPTER_METHOD_STATUS:-succeeded}" == retained ]]; then
                method_status=retained
            fi
            if [[ "$method_status" == failed ]]; then settle_registered_operation "removal:$removal_index" failed
            else settle_registered_operation "removal:$removal_index" succeeded; fi
            report_method_apps+=("$id"); report_method_modes+=("${apply_removal_modes[$removal_index]}")
            report_method_kinds+=("${apply_removal_kinds[$removal_index]}"); report_method_targets+=("${apply_removal_targets[$removal_index]}")
            report_method_statuses+=("$method_status")
        fi
        removal_index=$((removal_index + 1))
    done
    if [[ "$had_failure" == 1 ]]; then settle_app_operation "$index" failed; return 1; fi
    rm -f "$(receipt_path_for_app "$apply_os" "$id")"
    start_registered_operation "verify:$index"
    if [[ "${DOTFILES_INSTALL_PLAN_TRUSTED_TEST_PLAN:-0}" != 1 ]]; then
        result=$(inspect_app_by_id "$apply_os" "$id" | head -n 1)
        IFS=$'\t' read -r _ _ _ presence custody _ <<<"$result"
        report_observation_apps+=("$id"); report_observation_presence+=("$presence"); report_observation_custody+=("$custody")
        case "$presence" in
            absent) ;;
            present|partial) settle_app_operation "$index" partial; return 1 ;;
            *) settle_app_operation "$index" failed; return 1 ;;
        esac
    fi
    settle_app_operation "$index" succeeded
}

execute_plan_app() {
    local id=$1 operation=$2 path=${3:-} index status dependency_index prerequisite prerequisite_index
    local action_index had_failure=0 adapter_failed installer_before installer_before_digest installer_after installer_after_digest receipt_before result presence custody
    [[ "${interrupted:-0}" != 1 ]] || return 130
    index=$(find_value_index "$id" "${apply_app_ids[@]}") || return 1
    status=${apply_app_statuses[$index]}
    case "$status" in succeeded) return 0 ;; failed|partial|blocked) return 1 ;; running) return 1 ;; esac
    case "$path" in *"|$id|"*) settle_app_operation "$index" failed; return 1 ;; esac
    apply_app_statuses[$index]=running
    dependency_index=0
    while ((dependency_index < ${#apply_dependency_apps[@]})); do
        if [[ "${apply_dependency_apps[$dependency_index]}" == "$id" ]]; then
            prerequisite=${apply_dependency_requirements[$dependency_index]}
            prerequisite_index=$(find_value_index "$prerequisite" "${apply_app_ids[@]}") || {
                settle_app_operation "$index" blocked; return 1;
            }
            if ! execute_plan_app "$prerequisite" "$operation" "$path|$id|"; then
                settle_app_operation "$index" blocked
                return 1
            fi
        fi
        dependency_index=$((dependency_index + 1))
    done
    action_index=0
    while ((action_index < ${#apply_action_apps[@]})); do
        [[ "${interrupted:-0}" != 1 ]] || break
        if [[ "${apply_action_apps[$action_index]}" == "$id" && "${apply_action_done[$action_index]}" != 1 ]]; then
            installer_before=''; installer_before_digest=''; receipt_before=''; adapter_failed=0
            if [[ "${apply_action_kinds[$action_index]}" == installer ]]; then
                installer_before=$(command -v "$(installer_probe_command "${apply_action_values[$action_index]}")" 2>/dev/null || true)
                if [[ -n "$installer_before" && -f "$installer_before" ]]; then
                    installer_before_digest=$(sha256_file "$installer_before")
                fi
                receipt_before=$(validated_receipt_target "$apply_os" "$id" "${apply_action_values[$action_index]}" 2>/dev/null || true)
            fi
            start_action_operation "$action_index"
            _INSTALL_PLAN_CURRENT_ACTION_INDEX=$action_index
            run_plan_adapter "$operation" "${apply_action_kinds[$action_index]}" \
                "${apply_action_values[$action_index]}" "${apply_action_options[$action_index]}" || adapter_failed=1
            unset _INSTALL_PLAN_CURRENT_ACTION_INDEX
            if [[ "$adapter_failed" == 1 ]]; then
                settle_action_operation "$action_index" failed
                had_failure=1
            else
                settle_action_operation "$action_index" succeeded
                if [[ "${apply_action_kinds[$action_index]}" == installer ]]; then
                    installer_after=$(command -v "$(installer_probe_command "${apply_action_values[$action_index]}")" 2>/dev/null || true)
                    installer_after_digest=''
                    if [[ -n "$installer_after" && -f "$installer_after" ]]; then
                        installer_after_digest=$(sha256_file "$installer_after")
                    fi
                    if [[ -z "$installer_before" || -n "$receipt_before" ||
                          "$installer_after" != "$installer_before" ||
                          "$installer_after_digest" != "$installer_before_digest" ]]; then
                        write_installation_receipt "$apply_os" "$id" "${apply_action_values[$action_index]}"
                    fi
                fi
            fi
        fi
        action_index=$((action_index + 1))
    done
    if [[ "${interrupted:-0}" == 1 ]]; then
        settle_app_operation "$index" failed
        return 130
    fi
    if [[ "$had_failure" == 1 ]]; then settle_app_operation "$index" failed; return 1; fi
    start_registered_operation "verify:$index"
    if [[ "${DOTFILES_INSTALL_PLAN_TRUSTED_TEST_PLAN:-0}" != 1 ]]; then
        result=$(inspect_app_by_id "$apply_os" "$id" | head -n 1)
        IFS=$'\t' read -r _ _ _ presence custody _ <<<"$result"
        report_observation_apps+=("$id"); report_observation_presence+=("$presence"); report_observation_custody+=("$custody")
        case "$presence" in present) ;; partial) settle_app_operation "$index" partial; return 1 ;; *) settle_app_operation "$index" failed; return 1 ;; esac
    fi
    settle_app_operation "$index" succeeded
}

catalog_has_action() {
    local expected_app=$1 expected_kind=$2 expected_value=$3 expected_option=$4 index=0
    while ((index < ${#action_apps[@]})); do
        if [[ "${action_apps[$index]}" == "$expected_app" &&
              "${action_kinds[$index]}" == "$expected_kind" &&
              "${action_values[$index]}" == "$expected_value" &&
              "${action_options[$index]}" == "$expected_option" ]]; then
            return 0
        fi
        index=$((index + 1))
    done
    return 1
}

resolved_plan_has_action() {
    local expected_app=$1 expected_kind=$2 expected_value=$3 expected_option=$4 index=0
    while ((index < ${#apply_action_apps[@]})); do
        if [[ "${apply_action_apps[$index]}" == "$expected_app" &&
              "${apply_action_kinds[$index]}" == "$expected_kind" &&
              "${apply_action_values[$index]}" == "$expected_value" &&
              "${apply_action_options[$index]}" == "$expected_option" ]]; then
            return 0
        fi
        index=$((index + 1))
    done
    return 1
}

resolved_plan_has_dependency() {
    local expected_app=$1 expected_requirement=$2 index=0
    while ((index < ${#apply_dependency_apps[@]})); do
        if [[ "${apply_dependency_apps[$index]}" == "$expected_app" &&
              "${apply_dependency_requirements[$index]}" == "$expected_requirement" ]]; then
            return 0
        fi
        index=$((index + 1))
    done
    return 1
}

app_has_valid_receipt() {
    local os=$1 app=$2 index=0
    while ((index < ${#action_apps[@]})); do
        if [[ "${action_apps[$index]}" == "$app" && "${action_kinds[$index]}" == installer ]] &&
            validated_receipt_target "$os" "$app" "${action_values[$index]}" >/dev/null; then return 0; fi
        index=$((index + 1))
    done
    return 1
}

prepared_removal_is_catalogued() {
    local os=$1 app=$2 mode=$3 kind=$4 target=$5 option=$6 index=0
    if [[ "$mode" == exact ]]; then
        case "$kind" in
            apt-package|pacman-package|brew-formula|brew-cask|npm-package|cargo-package|ai-skill)
                catalog_has_action "$app" "$kind" "$target" "$option" && return 0 ;;
            path|payload-tree) app_has_valid_receipt "$os" "$app" || return 1 ;;
            *) return 1 ;;
        esac
    fi
    while ((index < ${#removal_apps[@]})); do
        if [[ "${removal_oses[$index]}" == "$os" && "${removal_apps[$index]}" == "$app" &&
              "${removal_methods[$index]}" == "$kind" && "${removal_targets[$index]}" == "$target" &&
              "${removal_options[$index]}" == "$option" ]]; then return 0; fi
        index=$((index + 1))
    done
    return 1
}

validate_prepared_removals() {
    local index=0 app_index removal_index found
    while ((index < ${#apply_removal_apps[@]})); do
        app_index=$(find_value_index "${apply_removal_apps[$index]}" "${apply_app_ids[@]}") ||
            fail "prepared removal has no application: ${apply_removal_apps[$index]}"
        if [[ "${apply_removal_modes[$index]}" == exact ]]; then
            [[ "${apply_app_outcomes[$app_index]}" == remove ]] ||
                fail "prepared removal differs from desired outcome: ${apply_removal_apps[$index]}"
        else
            case "${apply_app_outcomes[$app_index]}" in remove|force) ;;
                *) fail "prepared removal differs from desired outcome: ${apply_removal_apps[$index]}" ;;
            esac
        fi
        prepared_removal_is_catalogued "$apply_os" "${apply_removal_apps[$index]}" "${apply_removal_modes[$index]}" \
            "${apply_removal_kinds[$index]}" "${apply_removal_targets[$index]}" "${apply_removal_options[$index]}" ||
            fail "prepared removal is absent from catalog: ${apply_removal_apps[$index]} ${apply_removal_kinds[$index]}"
        index=$((index + 1))
    done
    for app_index in "${!apply_app_ids[@]}"; do
        case "${apply_app_outcomes[$app_index]}" in remove|force) ;; *) continue ;; esac
        found=0
        for removal_index in "${!apply_removal_apps[@]}"; do
            if [[ "${apply_removal_apps[$removal_index]}" == "${apply_app_ids[$app_index]}" ]]; then found=1; break; fi
        done
        [[ "$found" == 1 || ( "${apply_app_outcomes[$app_index]}" == remove && "${apply_app_presences[$app_index]}" == absent ) ]] ||
            fail "prepared run omitted removal methods for ${apply_app_ids[$app_index]}"
    done
}

validate_resolved_plan_against_catalog() {
    local index=0 catalog_index app_index selected step_index prerequisites prerequisite old_ifs
    local found_step_action action_scan
    load_catalog "$apply_os"
    while ((index < ${#apply_app_ids[@]})); do
        app_index=$(find_value_index "${apply_app_ids[$index]}" "${app_ids[@]}") ||
            fail "resolved plan application is absent from catalog: ${apply_app_ids[$index]}"
        if ! app_is_available "${apply_app_ids[$index]}"; then
            fail "resolved plan application is unavailable: ${apply_app_ids[$index]}"
        fi
        if [[ "${app_states[$app_index]}" == required && "${apply_app_states[$index]}" != on ]]; then
            fail "resolved plan disabled required application: ${apply_app_ids[$index]}"
        fi
        index=$((index + 1))
    done
    catalog_index=0
    while ((catalog_index < ${#app_ids[@]})); do
        if app_is_available "${app_ids[$catalog_index]}"; then
            find_value_index "${app_ids[$catalog_index]}" "${apply_app_ids[@]}" >/dev/null 2>&1 ||
                fail "resolved plan omitted available application: ${app_ids[$catalog_index]}"
        fi
        catalog_index=$((catalog_index + 1))
    done
    index=0
    while ((index < ${#apply_action_apps[@]})); do
        catalog_has_action "${apply_action_apps[$index]}" "${apply_action_kinds[$index]}" \
            "${apply_action_values[$index]}" "${apply_action_options[$index]}" ||
            fail "resolved plan action is absent from catalog: ${apply_action_apps[$index]} ${apply_action_kinds[$index]}"
        app_index=$(find_value_index "${apply_action_apps[$index]}" "${apply_app_ids[@]}") ||
            fail "resolved plan action has no application: ${apply_action_apps[$index]}"
        [[ "${apply_app_states[$app_index]}" == on ]] ||
            fail "resolved plan contains an action for a disabled application: ${apply_action_apps[$index]}"
        index=$((index + 1))
    done
    catalog_index=0
    while ((catalog_index < ${#action_apps[@]})); do
        if app_index=$(find_value_index "${action_apps[$catalog_index]}" "${apply_app_ids[@]}"); then
            selected=${apply_app_states[$app_index]}
            if [[ "$selected" == on ]]; then
                resolved_plan_has_action "${action_apps[$catalog_index]}" "${action_kinds[$catalog_index]}" \
                    "${action_values[$catalog_index]}" "${action_options[$catalog_index]}" ||
                    fail "resolved plan omitted catalog action: ${action_apps[$catalog_index]} ${action_kinds[$catalog_index]}"
            fi
        fi
        catalog_index=$((catalog_index + 1))
    done
    index=0
    while ((index < ${#apply_dependency_apps[@]})); do
        app_index=$(find_value_index "${apply_dependency_apps[$index]}" "${app_ids[@]}") ||
            fail "resolved plan dependency has unknown application: ${apply_dependency_apps[$index]}"
        prerequisites=${app_prerequisites[$app_index]}
        case ",$prerequisites," in
            *",${apply_dependency_requirements[$index]},"*) ;;
            *) fail "resolved plan dependency is absent from catalog: ${apply_dependency_apps[$index]}" ;;
        esac
        index=$((index + 1))
    done
    catalog_index=0
    while ((catalog_index < ${#app_ids[@]})); do
        if app_index=$(find_value_index "${app_ids[$catalog_index]}" "${apply_app_ids[@]}") &&
            [[ "${apply_app_states[$app_index]}" == on && -n "${app_prerequisites[$catalog_index]}" ]]; then
            prerequisites=${app_prerequisites[$catalog_index]}
            old_ifs=$IFS; IFS=','
            for prerequisite in $prerequisites; do
                resolved_plan_has_dependency "${app_ids[$catalog_index]}" "$prerequisite" ||
                    fail "resolved plan omitted prerequisite: ${app_ids[$catalog_index]} -> $prerequisite"
            done
            IFS=$old_ifs
        fi
        catalog_index=$((catalog_index + 1))
    done
    validate_prepared_removals
    index=0
    while ((index < ${#apply_step_ids[@]})); do
        step_index=$(find_value_index "${apply_step_ids[$index]}" "${step_ids[@]}") ||
            fail "resolved plan step is absent from catalog: ${apply_step_ids[$index]}"
        if [[ "${apply_step_states[$index]}" == on && "${step_adapters[$step_index]}" != dependencies ]]; then
            found_step_action=0; action_scan=0
            while ((action_scan < ${#apply_step_action_ids[@]})); do
                if [[ "${apply_step_action_ids[$action_scan]}" == "${apply_step_ids[$index]}" ]]; then found_step_action=1; break; fi
                action_scan=$((action_scan + 1))
            done
            [[ "$found_step_action" == 1 ]] || fail "resolved plan omitted step action: ${apply_step_ids[$index]}"
        fi
        index=$((index + 1))
    done
    index=0
    while ((index < ${#apply_step_action_ids[@]})); do
        step_index=$(find_value_index "${apply_step_action_ids[$index]}" "${step_ids[@]}") ||
            fail "resolved plan step action is absent from catalog: ${apply_step_action_ids[$index]}"
        [[ "${step_adapters[$step_index]}" == "${apply_step_action_kinds[$index]}" &&
           "${step_arguments[$step_index]}" == "${apply_step_action_values[$index]}" ]] ||
            fail "resolved plan step action differs from catalog: ${apply_step_action_ids[$index]}"
        index=$((index + 1))
    done
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
    else fail "SHA-256 verification requires sha256sum or shasum"; fi
}

validate_plan_approval() {
    local approval=$1 plan=$2 type value extra format_seen=0 digest=''
    [[ -r "$approval" ]] || fail "confirmed visual run approval is missing"
    while IFS=$'\t' read -r type value extra; do
        case "$type" in
            format) [[ "$value" == 1 && "$format_seen" == 0 && -z "${extra:-}" ]] || fail "invalid approval format"; format_seen=1 ;;
            digest) [[ "$value" =~ ^[0-9a-f]{64}$ && -z "$digest" && -z "${extra:-}" ]] || fail "invalid approval digest"; digest=$value ;;
            '') ;;
            *) fail "unknown approval record: $type" ;;
        esac
    done <"$approval"
    [[ "$format_seen" == 1 && "$digest" == "$(sha256_file "$plan")" ]] || fail "prepared run changed after confirmation"
}

write_run_report() {
    local output=$1 temporary index
    [[ -n "$output" ]] || return 0
    mkdir -p "$(dirname "$output")"
    temporary=$(mktemp "$(dirname "$output")/.run-report.XXXXXX")
    chmod 600 "$temporary"
    printf 'format\t1\n' >"$temporary"
    for index in "${!apply_removal_apps[@]}"; do
        printf 'target\t%s\t%s\t%s\t%s\n' "${apply_removal_apps[$index]}" "${apply_removal_modes[$index]}" \
            "${apply_removal_kinds[$index]}" "${apply_removal_targets[$index]}" >>"$temporary"
    done
    for index in "${!report_method_apps[@]}"; do
        printf 'method\t%s\t%s\t%s\t%s\t%s\n' "${report_method_apps[$index]}" "${report_method_modes[$index]}" \
            "${report_method_kinds[$index]}" "${report_method_targets[$index]}" "${report_method_statuses[$index]}" >>"$temporary"
    done
    for index in "${!report_observation_apps[@]}"; do
        printf 'post-observation\t%s\t%s\t%s\n' "${report_observation_apps[$index]}" \
            "${report_observation_presence[$index]}" "${report_observation_custody[$index]}" >>"$temporary"
    done
    for index in "${!apply_app_ids[@]}"; do
        printf 'result\t%s\t%s\n' "${apply_app_ids[$index]}" "${apply_app_statuses[$index]}" >>"$temporary"
    done
    mv -f "$temporary" "$output"
}

apply_plan() {
    local operation='' plan='' approval='' report='' index step_id step_failed=0 app_index action_index interrupted=0
    local step_action_failed dependency_failed
    shift
    while (($#)); do
        case "$1" in
            --operation) (($# >= 2)) || fail "--operation requires a value"; operation=$2; shift 2 ;;
            --plan) (($# >= 2)) || fail "--plan requires a path"; plan=$2; shift 2 ;;
            --approval) (($# >= 2)) || fail "--approval requires a path"; approval=$2; shift 2 ;;
            --report) (($# >= 2)) || fail "--report requires a path"; report=$2; shift 2 ;;
            *) fail "unknown apply argument: $1" ;;
        esac
    done
    case "$operation" in install|reconcile) ;; *) fail "invalid apply operation: $operation" ;; esac
    [[ -n "$plan" ]] || fail "apply requires --plan"
    load_resolved_plan "$plan"
    report_method_apps=(); report_method_modes=(); report_method_kinds=(); report_method_targets=(); report_method_statuses=()
    report_observation_apps=(); report_observation_presence=(); report_observation_custody=()
    if [[ "${apply_format:-1}" == 2 && "${DOTFILES_INSTALL_PLAN_TRUSTED_TEST_PLAN:-0}" != 1 ]]; then
        validate_plan_approval "$approval" "$plan"
    fi
    if [[ "${DOTFILES_INSTALL_PLAN_TRUSTED_TEST_PLAN:-0}" != 1 ||
          -z "${DOTFILES_INSTALL_PLAN_ADAPTER:-}" ]]; then
        validate_resolved_plan_against_catalog
    fi
    export NONINTERACTIVE=1 HOMEBREW_NO_ASK=1 DOTFILES_NONINTERACTIVE=1
    export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a GIT_TERMINAL_PROMPT=0
    exec </dev/null
    trap 'interrupted=1' INT TERM
    initialize_event_operations
    emit_event run-start "$event_total"

    index=0
    while ((index < ${#apply_step_ids[@]})); do
        step_id=${apply_step_ids[$index]}
        if [[ "${apply_step_states[$index]}" == off ]]; then
            index=$((index + 1)); continue
        fi
        if [[ "$interrupted" == 1 ]]; then step_failed=1; break; fi
        [[ "$step_id" == dependencies ]] || start_registered_operation "step:$index"
        if [[ "$step_id" == dependencies ]]; then
            execute_action_batches "$operation"
            app_index=0
            while ((app_index < ${#apply_app_ids[@]})); do
                [[ "$interrupted" != 1 ]] || break
                if [[ "${apply_app_outcomes[$app_index]}" == ensure ]]; then
                    execute_plan_app "${apply_app_ids[$app_index]}" "$operation" || true
                fi
                app_index=$((app_index + 1))
            done
            app_index=0
            while ((app_index < ${#apply_app_ids[@]})); do
                [[ "$interrupted" != 1 ]] || break
                case "${apply_app_outcomes[$app_index]}" in
                    remove|force) execute_plan_removal "${apply_app_ids[$app_index]}" || true ;;
                esac
                app_index=$((app_index + 1))
            done
            dependency_failed=0
            [[ "$interrupted" != 1 ]] || dependency_failed=1
            for app_index in "${!apply_app_statuses[@]}"; do
                case "${apply_app_statuses[$app_index]}" in failed|partial|blocked) dependency_failed=1 ;; esac
            done
            if [[ "$dependency_failed" == 1 ]]; then settle_step_operation "$index" failed
            else settle_step_operation "$index" succeeded; fi
        else
            step_action_failed=0
            action_index=0
            while ((action_index < ${#apply_step_action_ids[@]})); do
                [[ "$interrupted" != 1 ]] || break
                if [[ "${apply_step_action_ids[$action_index]}" == "$step_id" ]]; then
                    run_plan_adapter "$operation" "${apply_step_action_kinds[$action_index]}" \
                        "${apply_step_action_values[$action_index]}" "${apply_step_action_options[$action_index]}" || step_action_failed=1
                fi
                action_index=$((action_index + 1))
            done
            if [[ "$step_action_failed" == 1 ]]; then settle_step_operation "$index" failed
            else settle_step_operation "$index" succeeded; fi
        fi
        index=$((index + 1))
    done

    index=0
    while ((index < ${#apply_step_ids[@]})); do
        case "${apply_step_statuses[$index]}" in
            succeeded) printf 'succeeded: step %s\n' "${apply_step_ids[$index]}" ;;
            skipped) printf 'skipped: step %s\n' "${apply_step_ids[$index]}" ;;
            failed) printf 'failed: step %s\n' "${apply_step_ids[$index]}" >&2; step_failed=1 ;;
            pending) printf 'blocked: step %s\n' "${apply_step_ids[$index]}" >&2; step_failed=1 ;;
        esac
        index=$((index + 1))
    done
    app_index=0
    while ((app_index < ${#apply_app_ids[@]})); do
        case "${apply_app_statuses[$app_index]}" in
            succeeded) printf 'succeeded: %s\n' "${apply_app_ids[$app_index]}" ;;
            skipped) printf 'skipped: %s\n' "${apply_app_ids[$app_index]}" ;;
            failed) printf 'failed: %s\n' "${apply_app_ids[$app_index]}" >&2; step_failed=1 ;;
            partial) printf 'partial: %s\n' "${apply_app_ids[$app_index]}" >&2; step_failed=1 ;;
            blocked) printf 'blocked: %s\n' "${apply_app_ids[$app_index]}" >&2; step_failed=1 ;;
        esac
        app_index=$((app_index + 1))
    done
    write_run_report "$report"
    if [[ "$interrupted" != 0 ]]; then
        emit_event run-settled cancelled "$event_settled" "$event_total"
        echo 'Installation interrupted.' >&2
        return 130
    fi
    if [[ "$step_failed" == 0 ]]; then run_status=succeeded; else run_status=failed; fi
    emit_event run-settled "$run_status" "$event_settled" "$event_total"
    return "$step_failed"
}

usage() {
    cat <<'EOF'
Usage:
  lib/install-plan inspect --os OS --output FILE
  lib/install-plan prepare --mode visual|defaults|full|record|outcomes --os OS --output FILE [--record FILE]
  lib/install-plan execute --operation install|reconcile --plan FILE [--approval FILE] [--report FILE]
  lib/install-plan apply --operation install|reconcile --plan FILE
EOF
}

case "${1:-}" in
    inspect) inspect_plan "$@" ;;
    prepare) prepare_plan "$@" ;;
    execute|apply) apply_plan "$@" ;;
    --help|-h) usage ;;
    *) usage >&2; exit 2 ;;
esac
